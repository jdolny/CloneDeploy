<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="AgentVersion.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CloneDeploy-Agent.MacOS</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Portal/**/*.cs" />

    <None Remove="Portal/**/*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <EmbeddedResource Include="Updates/Install-MacUpdate.sh" LogicalName="Install-MacUpdate.sh" />
    <ProjectReference Include="../CloneDeploy-Agent.Core/CloneDeploy-Agent.Core.csproj" />


    <None Update="Packaging/**/*" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
