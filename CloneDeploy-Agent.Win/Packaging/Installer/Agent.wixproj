<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <OutputName>CloneDeploy-Agent-$(InstallerPlatform)</OutputName>
    <!-- e_sqlite3.dll lacks language metadata; Payload.wxs deliberately defaults it to neutral (0). -->
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1101</SuppressSpecificWarnings>
    <DefineConstants>AgentArchitecture=$(InstallerPlatform);AgentVersion=$(AgentVersion);AgentProductCode=$(AgentProductCode)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GeneratedPayloadPath)" />
  </ItemGroup>
</Project>
