<UserControl x:Class="CloneDeploy_Agent.UI.HelpDeskPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:local="clr-namespace:CloneDeploy_Agent.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="HelpInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="RequestItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource PortalBorder}" BorderThickness="0,0,0,1">
     <Border x:Name="Selection" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="12,14"><ContentPresenter/></Border>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PortalRaised}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandAccentTint}"/><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer x:Name="layoutScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid x:Name="layout" MinHeight="440" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="205"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource PortalBorder}" BorderThickness="1" CornerRadius="9">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="12">
      <Button x:Name="newRequest" Style="{DynamicResource BrandPrimaryButton}" Padding="10,9" Margin="0,0,0,14" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Path Data="M10,2 H14 V10 H22 V14 H14 V22 H10 V14 H2 V10 H10 Z" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="newRequestLabel" Text="{local:Loc HelpDesk.NewHelpRequest}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></StackPanel></Button>
      <ComboBox x:Name="filter" SelectedIndex="0" AutomationProperties.Name="{local:Loc HelpDesk.FilterRequestsByStatus}">
       <ComboBoxItem Content="{local:Loc HelpDesk.AllMyRequests}"/><ComboBoxItem Content="{local:Loc HelpDesk.AwaitingReview}"/><ComboBoxItem Content="{local:Loc HelpDesk.InProgress}"/><ComboBoxItem Content="{local:Loc HelpDesk.WaitingOnYou}"/><ComboBoxItem Content="{local:Loc HelpDesk.Closed}"/>
      </ComboBox>
     </StackPanel>
     <ListBox x:Name="tickets" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource RequestItem}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{local:Loc HelpDesk.MyHelpRequests}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding Ticket.Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Updated}" Foreground="{DynamicResource PortalMuted}" FontSize="11" Margin="0,6,0,8"/>
       <DockPanel><TextBlock Text="{Binding UnreadLabel}" Foreground="{DynamicResource BrandAccentText}" FontSize="11" VerticalAlignment="Center"/>
        <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="8,4" HorizontalAlignment="Right"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="SemiBold"/></Border>
       </DockPanel>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6">
      <Button x:Name="previous" Content="{local:Loc HelpDesk.Previous}" Padding="8,4" Margin="0,0,6,0"/>
      <Button x:Name="next" Content="{local:Loc HelpDesk.Next}" Padding="8,4"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" BorderBrush="{DynamicResource PortalBorder}" BorderThickness="1" CornerRadius="9" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="1" ToolTip="{local:Loc HelpDesk.AutomaticReplies}" ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="30000" BorderBrush="{DynamicResource PortalBorder}" BorderThickness="0,1" Padding="0,8" Margin="0,0,0,10">
      <DockPanel>
       <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PortalMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock DockPanel.Dock="Right" Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PortalMuted}" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="True" AutomationProperties.Name="{local:Loc HelpDesk.AboutSupportRequests}" ToolTip="{local:Loc HelpDesk.AutomaticReplies}" ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="30000"/>
       <TextBlock x:Name="SupportResponseText" Text="{local:Loc HelpDesk.DefaultSupportResponse}" FontSize="11" Foreground="{DynamicResource PortalMuted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <ScrollViewer x:Name="conversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel><Button x:Name="older" Content="{local:Loc HelpDesk.LoadEarlierMessages}" Visibility="Collapsed" HorizontalAlignment="Center" Padding="10,5"/>
       <StackPanel x:Name="conversation"/>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock x:Name="subjectLabel" Text="{local:Loc HelpDesk.BriefDescription}"/>
      <TextBox x:Name="subject" Style="{StaticResource HelpInput}" MaxLength="200" Padding="8" Margin="0,6,0,8" AutomationProperties.Name="{local:Loc HelpDesk.BriefDescription}"/>
      <TextBlock x:Name="bodyLabel" Text="{local:Loc HelpDesk.DetailedDescription}" Margin="0,4,0,6" FontSize="12" Foreground="{DynamicResource PortalMuted}"/>
      <Grid Visibility="{Binding Visibility, ElementName=body}">
      <TextBox x:Name="body" Style="{StaticResource HelpInput}" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="110"
               VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="{local:Loc HelpDesk.DescriptionOrReply}"/>
       <TextBlock x:Name="replyPlaceholder" Text="{local:Loc HelpDesk.ReplyPlaceholder}" Margin="12,10" Foreground="{DynamicResource PortalMuted}" IsHitTestVisible="False" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
         <MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Text, ElementName=body}" Value=""/>
          <Condition Binding="{Binding Tag, ElementName=body}" Value="reply"/>
         </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Border x:Name="attachmentCard" Visibility="Collapsed" BorderBrush="{DynamicResource PortalBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,8,0,0" Background="{DynamicResource PortalRaised}">
       <DockPanel>
        <Button x:Name="removeScreenshot" DockPanel.Dock="Right" Content="×" Padding="8,4" VerticalAlignment="Center" ToolTip="{local:Loc HelpDesk.RemoveScreenshot}" ToolTipService.InitialShowDelay="0" AutomationProperties.Name="{local:Loc HelpDesk.RemoveAttachedScreenshot}"/>
        <Button x:Name="previewScreenshot" Background="Transparent" BorderThickness="0" Padding="4" HorizontalContentAlignment="Left" ToolTip="{local:Loc HelpDesk.PreviewAttachedScreenshot}" AutomationProperties.Name="{local:Loc HelpDesk.PreviewAttachedScreenshot}">
         <StackPanel Orientation="Horizontal">
          <Image x:Name="attachmentThumbnail" Width="48" Height="32" Stretch="Uniform" Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Loc HelpDesk.ScreenshotAttached}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{local:Loc Screenshot.PreviewHint}" FontSize="10" Foreground="{DynamicResource PortalMuted}"/></StackPanel>
         </StackPanel>
        </Button>
       </DockPanel>
      </Border>
      <WrapPanel Margin="0,10,0,0">
       <Button x:Name="submit" Content="{local:Loc HelpDesk.SubmitRequest}" Style="{DynamicResource BrandPrimaryButton}" Padding="12,8" Margin="0,0,8,6"/>
       <Button x:Name="screenshot" Content="{local:Loc HelpDesk.TakeScreenshot}" Padding="10,8" Margin="0,0,8,6"/>
      </WrapPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <TextBlock x:Name="status" Grid.Row="1" Foreground="{DynamicResource PortalMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </Grid>
 </ScrollViewer>
</UserControl>
