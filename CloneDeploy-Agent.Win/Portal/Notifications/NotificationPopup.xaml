<Window x:Class="CloneDeploy_Agent.UI.NotificationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CloneDeploy_Agent.UI"
        Title="{local:Loc Notifications.CloneDeployMessage}" Width="740" SizeToContent="Height" MaxHeight="600"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="Transparent" Foreground="{DynamicResource PortalText}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/CloneDeploy-Agent.UI;component/Assets/Branding.xaml"/><ResourceDictionary Source="/CloneDeploy-Agent.UI;component/Assets/Accent.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border CornerRadius="14" Background="{DynamicResource PortalSurface}" BorderBrush="{DynamicResource PortalBorder}" BorderThickness="1">
        <Grid x:Name="NotificationLayout" MinHeight="290">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="BrandPanel" CornerRadius="13,0,0,13" Background="#2459D6" Padding="20,26,20,18">
                <Grid>
                    <StackPanel x:Name="CompactBrandHeader" Orientation="Horizontal" Visibility="Collapsed">
                        <Image Source="{Binding Source, ElementName=BrandLogo}" Width="28" Height="24" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock x:Name="CompactBrandName" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                    </StackPanel>
                <Grid x:Name="ExpandedBrandContent">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="BrandIdentity" HorizontalAlignment="Stretch">
                        <Image x:Name="BrandLogo" Source="{StaticResource CloneDeployLogo}" Height="76" MaxWidth="136" Stretch="Uniform" Margin="0,0,0,14"/>
                        <TextBlock x:Name="BrandName" Text="CloneDeploy" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BrandTagline" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <Border x:Name="BrandDivider" Height="1" Background="White" Opacity="0.3" Margin="0,0,0,12"/>
                        <TextBlock x:Name="PoweredBy" Text="{local:Loc Common.PoweredBy}" Foreground="White" Opacity="0.8" TextAlignment="Center" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Image x:Name="ProductLogo" Source="{StaticResource CloneDeployLogo}" Width="30" Height="25" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ProductName" Text="CloneDeploy" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>
            <Grid x:Name="NotificationContent" Grid.Column="1" Margin="28,38,28,26">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="NotificationIcon" Visibility="Collapsed" Grid.RowSpan="2" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrandAccent}" VerticalAlignment="Top" Margin="0,2,12,0">
                    <TextBlock x:Name="NotificationGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{DynamicResource BrandAccentForeground}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="NotificationTitle" Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource PortalText}" Margin="0,0,12,0"/>
                <ScrollViewer Grid.Column="1" x:Name="NotificationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="260" Margin="0,16,0,0">
                    <TextBlock x:Name="NotificationBody" local:NotificationText.Text="{Binding Body}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource PortalText}"/>
                </ScrollViewer>
            <Button x:Name="ToastOpenButton" Visibility="Collapsed" Grid.RowSpan="2" Grid.ColumnSpan="2" Click="ViewMessages" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="FocusBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="13"/>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource BrandAccentText}"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
            </Button>
                <WrapPanel Grid.Column="1" x:Name="NotificationActions" Grid.Row="2" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button x:Name="OpenActionButton" Style="{StaticResource BrandPrimaryButton}" Click="ViewMessages" Padding="12,8" Margin="0,4,8,0" Visibility="Collapsed"/>
                    <Button x:Name="AcknowledgeButton" Style="{StaticResource BrandPrimaryButton}" Content="{local:Loc Common.Acknowledge}" Click="Acknowledge" Padding="12,8" Margin="0,4,8,0" Visibility="Collapsed"/>
                    <Button x:Name="DismissButton" Content="{local:Loc Common.Dismiss}" Click="Dismiss" Padding="12,8" Margin="0,4,0,0" Foreground="{DynamicResource BrandAccentText}"/>
                </WrapPanel>
            </Grid>
            <Button x:Name="CloseButton" Grid.Column="1" Content="×" Click="Dismiss" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,9,0" Padding="5,0" FontSize="23" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Loc Notifications.CloseMessage}" ToolTip="{local:Loc Notifications.CloseMessage}"/>
        </Grid>
    </Border>
</Window>
