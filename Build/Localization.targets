<Project>
  <UsingTask TaskName="GenerateLocalizationKeys" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResourceFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" /><Using Namespace="System.Text" /><Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var resources = XDocument.Load(ResourceFile).Root.Elements("data").ToList();
        var values = new Dictionary<string, string>(StringComparer.Ordinal);
        var resourceNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var accessors = new SortedDictionary<string, string>(StringComparer.Ordinal);
        foreach (var resource in resources)
        {
            var key = (string)resource.Attribute("name");
            if (key == null || !resourceNames.Add(key)) { Log.LogError("Duplicate or missing localization key: " + key); return false; }
            values.Add(key, (string)resource.Element("value") ?? "");
            var paths = new List<string> { "LocKeys." + string.Join(".", key.Split('.').Select(p => Regex.Replace(Regex.IsMatch(p, "^[0-9]") ? "_" + p : p, "[^A-Za-z0-9_]", "_"))) };
            var segments = paths[0].Split('.');
            if (segments.Length > 1 && segments[segments.Length - 1] == segments[segments.Length - 2]) paths[0] += "Text";
            if (resources.Any(r => ((string)r.Attribute("name")).StartsWith(key + ".", StringComparison.Ordinal))) paths[0] += "Text";
            segments = paths[0].Split('.');
            for (var i = 1; i < segments.Length - 1; i++) if (segments[i] == segments[i - 1]) segments[i] += "Group";
            paths[0] = string.Join(".", segments);
            foreach (Match alias in Regex.Matches((string)resource.Element("comment") ?? "", @"@accessor\s+([A-Za-z_][A-Za-z0-9_.]*)")) paths.Add(alias.Groups[1].Value);
            foreach (var path in paths.Distinct())
            {
                if (!Regex.IsMatch(path, @"^(LocKeys|ErrorKeys)(\.[A-Za-z_][A-Za-z0-9_]*)+$")) { Log.LogError("Invalid resource accessor: " + path); return false; }
                if (accessors.ContainsKey(path) && accessors[path] != key) { Log.LogError("Conflicting resource accessor: " + path); return false; }
                accessors[path] = key;
            }
        }
        foreach (var translation in Directory.GetFiles(Path.GetDirectoryName(ResourceFile), "LocalizationResources.*.resx"))
        {
            var seen = new HashSet<string>();
            foreach (var resource in XDocument.Load(translation).Root.Elements("data"))
            {
                var key = (string)resource.Attribute("name");
                if (key == null || !seen.Add(key) || !values.ContainsKey(key)) { Log.LogError("Unknown or duplicate translation key in " + translation + ": " + key); return false; }
                Func<string, string> placeholders = text => string.Join("|", Regex.Matches(text, @"(?<!\{)\{(?:\d+|[A-Za-z_][A-Za-z0-9_]*)(?:[^{}]*)\}").Cast<Match>().Select(m => m.Value).OrderBy(x => x));
                if (placeholders(values[key]) != placeholders((string)resource.Element("value") ?? "")) { Log.LogError("Translation placeholders differ in " + translation + ": " + key); return false; }
            }
        }
        var code = new StringBuilder("// <auto-generated/>\n#pragma warning disable CS0108\nnamespace CloneDeploy_Server.Localization;\n");
        Action<string, int> emit = null;
        emit = (prefix, depth) =>
        {
            var children = accessors.Keys.Where(k => k.StartsWith(prefix, StringComparison.Ordinal)).Select(k => k.Substring(prefix.Length).Split('.')[0]).Distinct().ToList();
            foreach (var child in children)
            {
                var full = prefix + child;
                var indent = new string(' ', depth * 4);
                if (accessors.ContainsKey(full)) code.AppendLine(indent + "public const string @" + child + " = \"" + accessors[full] + "\";");
                else { code.AppendLine(indent + "public static class @" + child + "\n" + indent + "{"); emit(full + ".", depth + 1); code.AppendLine(indent + "}"); }
            }
        };
        emit("", 0);
        var cultures = new[] { "en" }.Concat(Directory.GetFiles(Path.GetDirectoryName(ResourceFile), "LocalizationResources.*.resx")
            .Select(f => Path.GetFileName(f).Substring("LocalizationResources.".Length).Replace(".resx", ""))).Distinct().OrderBy(x => x).ToArray();
        foreach (var culture in cultures) System.Globalization.CultureInfo.GetCultureInfo(culture);
        code.AppendLine("internal static class UiResourceCultures { internal static readonly string[] Names = new[] { " + string.Join(", ", cultures.Select(c => "\"" + c + "\"")) + " }; }");
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != code.ToString()) File.WriteAllText(OutputFile, code.ToString());
      ]]></Code>
    </Task>
  </UsingTask>
  <PropertyGroup>
    <LocalizationResourceFile Condition="'$(LocalizationResourceFile)' == ''">$(MSBuildProjectDirectory)/Localization/LocalizationResources.resx</LocalizationResourceFile>
  </PropertyGroup>
  <Target Name="GenerateApplicationLocalizationKeys" BeforeTargets="CoreCompile">
    <GenerateLocalizationKeys ResourceFile="$(LocalizationResourceFile)" OutputFile="$(IntermediateOutputPath)LocalizationKeys.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)LocalizationKeys.g.cs" /></ItemGroup>
  </Target>
</Project>
