<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="../Build/ServerRuntime.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Published/**;Mounts/**;Staging/**;Temp/**</DefaultItemExcludes>
    <RootNamespace>CloneDeploy.SiteService</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <ProjectReference Include="../CloneDeploy-SiteService.Transport/CloneDeploy-SiteService.Transport.csproj" />
    <ProjectReference Include="../CloneDeploy-Agent.Contracts/CloneDeploy-Agent.Contracts.csproj" />


  </ItemGroup>
  <!-- Reuse the tested wire protocols without referencing the web application or its database. -->
  <ItemGroup>
    <Compile Include="../CloneDeploy-Server/Backend/Services/StorageProvider/Mounting/WindowsStorageLinks.cs" Link="Storage/WindowsStorageLinks.cs" />
    <Compile Include="../CloneDeploy-Server/Backend/Services/Pxe/Protocol/*.cs" Link="Boot/Protocol/Pxe/%(Filename)%(Extension)" />
    <Compile Include="../CloneDeploy-Server/Backend/Services/Pxe/Dtos/PxeSettingsDto.cs" Link="Boot/Protocol/PxeSettingsDto.cs" />
    <Compile Include="../CloneDeploy-Server/Backend/Services/Pxe/Dtos/PxeReplyDto.cs" Link="Boot/Protocol/PxeReplyDto.cs" />
    <Compile Include="../CloneDeploy-Server/Backend/Services/Pxe/Native/NativePxeReservations.cs" Link="Boot/Protocol/NativePxeReservations.cs" />
    <Compile Include="../CloneDeploy-Server/Backend/Services/Tftp/Protocol/*.cs" Link="Boot/Protocol/Tftp/%(Filename)%(Extension)" />
    <Content Include="../CloneDeploy-Server/Backend/Services/Tftp/Protocol/LICENSE.txt" Link="TFTP-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../third_party/udpcast/Udpcast.targets" />

  <ItemGroup>
    <ProjectReference Include="../CloneDeploy-Service.Client/CloneDeploy-Service.Client.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LocalizationResourceFile>$(MSBuildProjectDirectory)/../CloneDeploy-Server/Localization/LocalizationResources.resx</LocalizationResourceFile>
  </PropertyGroup>
  <Import Project="../Build/Localization.targets" />
</Project>
