{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CloneDeploy-Server-Database": "server=localhost;port=5432;database=CloneDeploy-Server;Uid=clonedeploy_admin;Pwd=password;"
  },
  "Server": {
    "AgentAdmin": {
      "AllowedNetworks": ""
    },
    "Listeners": {
      "Enabled": true,
      "ListenAddress": "0.0.0.0",
      "ManagementPort": 443,
      "ServicePort": 8443,
      "PortalPort": 8444,
      "HttpPort": 80
    }
  }
}
