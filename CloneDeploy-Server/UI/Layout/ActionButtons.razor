@using Microsoft.AspNetCore.Components.Sections

<SectionContent SectionName="page-actions">
    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
        @MainButton
        @if (Content is not null)
        {
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;" aria-label="@Loc[LocKeys.Ui.ActionButtons.MoreActions]">
                @Content
            </MudMenu>
        }
    </MudButtonGroup>
</SectionContent>

@code {
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public RenderFragment? MainButton { get; set; }
}
