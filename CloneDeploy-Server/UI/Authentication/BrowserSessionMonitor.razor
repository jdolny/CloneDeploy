@using System.Security.Claims
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    private IJSObjectReference? _module, _watch;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true || _disposed) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserSession.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _watch = await _module.InvokeAsync<IJSObjectReference>("watch", user.FindFirstValue(ClaimTypes.NameIdentifier));
            if (_disposed) await DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_watch is not null) { await _watch.InvokeVoidAsync("dispose"); await _watch.DisposeAsync(); _watch = null; }
            if (_module is not null) { await _module.DisposeAsync(); _module = null; }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
    }
}
