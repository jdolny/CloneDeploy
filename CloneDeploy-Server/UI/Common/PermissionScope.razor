@inject IAuthorizationService Authorization

@ChildContent(_allowed)

@code {
    [Parameter, EditorRequired] public string Policy { get; set; } = "";
    [Parameter, EditorRequired] public RenderFragment<bool> ChildContent { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private Task<AuthenticationState>? _checkedAuthentication;
    private string? _checkedPolicy;
    private long _checkVersion;
    private bool _allowed;

    protected override async Task OnParametersSetAsync()
    {
        // ChildContent changes on ordinary parent renders. Keep the form mounted and
        // authorize only when the identity or requested permission actually changes.
        if (ReferenceEquals(_checkedAuthentication, AuthenticationState) && _checkedPolicy == Policy) return;

        var authentication = AuthenticationState
            ?? throw new InvalidOperationException("PermissionScope requires a cascading authentication state.");
        var policy = Policy;
        var version = ++_checkVersion;
        _checkedAuthentication = authentication;
        _checkedPolicy = policy;
        _allowed = false;

        var state = await authentication;
        if (version != _checkVersion || state.User.Identity?.IsAuthenticated != true) return;
        var result = await Authorization.AuthorizeAsync(state.User, policy);
        // A slow response for an earlier identity/policy must not restore access.
        if (version == _checkVersion) _allowed = result.Succeeded;
    }
}
