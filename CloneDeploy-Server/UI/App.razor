@using CloneDeploy_Server.UI.Pages.Account
@using CloneDeploy_Server.UI.Pages.Dashboard
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">

<head>
      <title>CloneDeploy</title>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
      <base href="/"/>
      <script id="cd-localization" type="application/json">@((MarkupString)System.Text.Json.JsonSerializer.Serialize(UiText.BrowserResources()))</script>
      <script src="@Assets["js/localization.js"]"></script>

      <ResourcePreloader/>

      <link rel="stylesheet"
            href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap"/>

      <link rel="stylesheet"
            href="@Assets["_content/MudBlazor/MudBlazor.min.css"]"/>

      <link rel="stylesheet"
            href="@Assets["app.css"]"/>

      <link rel="stylesheet"
            href="@Assets["CloneDeploy-Server.styles.css"]"/>

      <ImportMap/>
      <link rel="stylesheet" href="@Assets["css/script-editor.css"]" />

      <link rel="icon" type="image/svg+xml" sizes="any" href="@Assets["branding/clonedeploy.svg"]"/>
      <link rel="icon" type="image/svg+xml" sizes="any" href="@Assets["branding/clonedeploy-on-dark.svg"]" media="(prefers-color-scheme: dark)"/>

      <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: true)"/>
</head>

<body>
<Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />

<ReconnectModal />
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
<script type="module" src="@Assets["js/script-editor.js"]"></script>
<script type="module" src="@Assets["js/device-search-grid.js"]"></script>
</body>
</html>
