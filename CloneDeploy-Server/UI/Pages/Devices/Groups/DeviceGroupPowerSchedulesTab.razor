@inject DeviceGroupService Service
@inject AuthenticationStateProvider Authentication
@inject ScheduleService Calculator

<div class="section-action-bar">
    <MudButton OnClick="@(() => Edit(null))" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.AssignPowerSchedule]</MudButton>
</div>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
<MudDataGrid T="DeviceGroupPowerSchedule" Items="_items" Loading="_busy" Dense="true" Hover="true" Outlined="true" Elevation="0" Class="device-list-grid" RowsPerPage="25">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Color="Color.Primary" />
        <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.PowerSchedules]</MudText>
        <MudSpacer />
        <MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Dashboard.Refresh]"><MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="_busy" OnClick="Load" aria-label="@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.RefreshPowerSchedules]" /></MudTooltip>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Schedule.Name" Title="@Loc[LocKeys.Common.Schedule]" />
        <PropertyColumn Property="x => x.Action" Title="@Loc[LocKeys.Dashboard.Action]" />
        <PropertyColumn Property="x => x.Enabled" Title="@Loc[LocKeys.StorageProvider.Enabled]" />
        <TemplateColumn Title="@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.NextOccurrence]">
            <CellTemplate>@Next(context.Item)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Scheduler.LastRun]">
            <CellTemplate>@(context.Item.LastRunAtUtc?.ToLocalTime().ToString("g") ?? "—")</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.LastResult" Title="@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.LastResult]" />
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" Sortable="false" StickyRight="true">
            <CellTemplate>
                <MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Common.Edit]"><MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Disabled="_busy" OnClick="@(() => Edit(context.Item))" aria-label="@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.EditPowerSchedule]" /></MudTooltip>
                <MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.Remove]"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Disabled="_busy" OnClick="@(() => Delete(context.Item))" aria-label="@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.RemovePowerSchedule]" /></MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">@Loc[LocKeys.Ui.DeviceGroupPowerSchedulesTab.NoPowerSchedulesAssigned]</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="DeviceGroupPowerSchedule" /></PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int GroupId { get; set; }
    private List<DeviceGroupPowerSchedule> _items = [];
    private bool _busy;
    private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private string Next(DeviceGroupPowerSchedule row) => row.Enabled
        ? Calculator.GetNextScheduledTime(row.Schedule, DateTime.UtcNow)?.ToLocalTime().ToString("g") ?? "—" : UiText.Get(LocKeys.Ui.CertificateAuthorityTab.Disabled);
    private async Task Load()
    {
        _busy = true;
        try { _items = await Service.GetPowerScheduleAsync((await Authentication.GetAuthenticationStateAsync()).User, GroupId); _error = null; }
        catch { _error = UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.PowerSchedulesCouldNotBeLoaded); }
        finally { _busy = false; }
    }
    private async Task Edit(DeviceGroupPowerSchedule? row)
    {
        if (_busy) return;
        var parameters = new DialogParameters<DeviceGroupPowerScheduleDialog> { { x => x.GroupId, GroupId }, { x => x.Assignment, row } };
        var dialog = await Dialog.ShowAsync<DeviceGroupPowerScheduleDialog>(row is null ? UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.AssignPowerSchedule) : UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.EditPowerSchedule), parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false }) await Load();
    }
    private async Task Delete(DeviceGroupPowerSchedule row)
    {
        if (_busy || await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.RemovePowerSchedule), UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.Remove0Using1FromThisGroup, (row.Action), (row.Schedule.Name)), yesText: UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.Remove), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true) return;
        _busy = true;
        try
        {
            await Service.DeletePowerScheduleAsync((await Authentication.GetAuthenticationStateAsync()).User, GroupId, row.Id);
            Snackbar.Add(UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.PowerScheduleRemoved), Severity.Success);
            await Load();
        }
        catch { _error = UiText.Get(LocKeys.Ui.DeviceGroupPowerSchedulesTab.PowerScheduleCouldNotBeRemoved); }
        finally { _busy = false; }
    }
}

