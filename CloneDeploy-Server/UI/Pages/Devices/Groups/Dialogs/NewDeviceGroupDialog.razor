@inject DeviceGroupService DeviceGroupService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Loc[LocKeys.Group.NewGroup]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="DeviceGroup.Name" Label="@Loc[LocKeys.Common.Name]" Variant="Variant.Outlined" Required="true" MaxLength="200" Disabled="_saving"/>
            <MudTextField @bind-Value="DeviceGroup.Description" Label="@Loc[LocKeys.Common.Description]" Variant="Variant.Outlined" Lines="3" Disabled="_saving"/>
            <MudSelect T="DeviceGroupType" @bind-Value="DeviceGroup.Type" Label="@Loc[LocKeys.Group.MembershipMode]"
                       Variant="Variant.Outlined" Disabled="_saving">
                <MudSelectItem Value="DeviceGroupType.Manual">@Loc[LocKeys.Group.Manual]</MudSelectItem>
                <MudSelectItem Value="DeviceGroupType.Dynamic">@Loc[LocKeys.Group.Dynamic]</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_saving" OnClick="OnCancelClicked">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="@OnCreateClicked">@Loc[LocKeys.Common.Create]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public DeviceGroup DeviceGroup { get; set; } = new() { Name = string.Empty };
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _saving;

    private void OnCancelClicked() => MudDialog.Cancel();

    private async Task OnCreateClicked()
    {
        if (_saving) return;
        _saving = true;
        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            _saving = false;
            return;
        }

        var result = await DeviceGroupService.CreateAsync(DeviceGroup);
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        else if (result.HasData)
        {
            Snackbar.Add(Loc[LocKeys.Common.Created, result.Data.Name], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }

        _saving = false;
    }
}
