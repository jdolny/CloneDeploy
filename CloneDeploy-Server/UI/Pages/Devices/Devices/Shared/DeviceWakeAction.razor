@inject AgentService Wake
@inject AuthenticationStateProvider Authentication
@inject ILogger<DeviceWakeAction> Logger

@if (MenuItem)
{
    <MudMenuItem Label="@Loc[LocKeys.Ui.DeviceGroupPowerScheduleDialog.WakeUp]" Icon="@Icons.Material.Filled.PowerSettingsNew" Disabled="@(_busy || Disabled)" OnClick="@Snackbar.GuardAction(() => Archived, UiText.Get(LocKeys.Ui.DeviceWakeAction.RestoreThisDeviceBeforeWakingIt), SendAsync)" />
}
else
{
    <MudButton StartIcon="@Icons.Material.Filled.PowerSettingsNew" Disabled="@(_busy || Disabled)" OnClick="@Snackbar.GuardAction(() => Archived, UiText.Get(LocKeys.Ui.DeviceWakeAction.RestoreThisDeviceBeforeWakingIt), SendAsync)">@(_busy ? UiText.Get(LocKeys.Ui.DeviceWakeAction.SendingWakeUp) : UiText.Get(LocKeys.Ui.DeviceWakeAction.WakeUpDevices))</MudButton>
}

@code {
    [Parameter] public int DeviceId { get; set; }
    [Parameter] public int? GroupId { get; set; }
    [Parameter] public bool MenuItem { get; set; } = true;
    [Parameter] public bool Archived { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private bool _busy;
    private async Task SendAsync()
    {
        if (_busy || Disabled) return;
        _busy = true;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = GroupId is { } group ? await Wake.WakeGroupAsync(user, group) : await Wake.WakeDeviceAsync(user, DeviceId);
            Snackbar.Add(result.Detail, result.Sent == result.Requested ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Wake-up request failed");
            Snackbar.Add(UiText.Get(LocKeys.Ui.DeviceWakeAction.CouldNotSendWakeUpPackets), Severity.Warning);
        }
        finally { _busy = false; }
    }
}
