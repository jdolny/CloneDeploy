@typeparam TItem

<MudDataGrid T="TItem" Items="Items" Dense="true" Hover="true" Elevation="0"
             QuickFilter="MatchesSearch" @bind-CurrentPage="_currentPage"
             Filterable="Filterable" FilterMode="DataGridFilterMode.ColumnFilterMenu"
             FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
             RowsPerPage="@(Pageable ? Constants.UI.DefaultPageSize : Math.Max(1, Items.Count()))" HorizontalScrollbar="true"
             ShowMenuIcon="false" Class="device-list-grid device-inventory-grid">
        <ToolBarContent>
            @if (TitleIcon is not null)
            {
                <DeviceInventoryHeading Title="@Title" Icon="@TitleIcon" />
            }
            else
            {
                <MudText Typo="Typo.h6">@Title</MudText>
            }
            <MudSpacer />
            @if (SearchText is not null)
            {
                <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="@Loc[LocKeys.Device.SearchInventory, Title]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="device-inventory-search"/>
            }
        </ToolBarContent>
        <Columns>@Columns</Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body2"
                     Class="pa-4">@(SearchText is not null && !string.IsNullOrWhiteSpace(_search) ? Loc[LocKeys.Device.NoMatchingRecords].Value : EmptyText ?? Loc[LocKeys.Device.NoInventoryRecords].Value)</MudText>
        </NoRecordsContent>
        <PagerContent>
            @if (Pageable)
            {
                <MudDataGridPager T="TItem"/>
            }
        </PagerContent>
    </MudDataGrid>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment? Columns { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string? TitleIcon { get; set; }
    [Parameter] public bool Pageable { get; set; } = true;
    [Parameter] public bool Filterable { get; set; } = true;
    [Parameter] public Func<TItem, string>? SearchText { get; set; }

    private string? _search;
    private int _currentPage;

    private void OnSearchChanged(string? value)
    {
        _search = value?.Trim();
        _currentPage = 0;
    }

    private bool MatchesSearch(TItem item) => SearchText is null || string.IsNullOrWhiteSpace(_search) ||
                                              SearchText(item).Contains(_search, StringComparison.OrdinalIgnoreCase);

}
