@using CloneDeploy_Server.UI.Pages.Devices.Devices.Dialogs
<MudDataGrid T="Comment" Items="Comments" Dense="true" Hover="true" Elevation="0" Class="device-list-grid"
             RowsPerPage="@Constants.UI.DefaultPageSize" HorizontalScrollbar="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Loc[LocKeys.Device.Comments]</MudText>
        <MudSpacer />
        <DeviceTabAction SectionId="ActionSectionId">
        <PermissionView Policy="@Constants.Permissions.DeviceEdit">
            <MudButton OnClick="OnAddCommentClicked" Disabled="_dialogOpen" StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Ui.DeviceCommentsTab.AddComment]</MudButton>
        </PermissionView>
        </DeviceTabAction>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.CommentedAtUtc" Title="@Loc[LocKeys.Ui.DeviceCommentsTab.Added]">
            <CellTemplate>@context.Item.CommentedAtUtc.ToLocalTime().ToString("g")</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Username" Title="@Loc[LocKeys.Ui.DeviceCommentsTab.Author]" />
        <PropertyColumn Property="x => x.CommentText" Title="@Loc[LocKeys.Ui.DeviceCommentsTab.Comment]" Sortable="false">
            <CellTemplate><div class="device-inventory-content">@context.Item.CommentText</div></CellTemplate>
        </PropertyColumn>
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">@Loc[LocKeys.Device.NoCommentsAreRecordedForThisDevice]</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="Comment" /></PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public Device Device { get; set; } = null!;
    [Parameter] public object? ActionSectionId { get; set; }
    private bool _dialogOpen;
    private IEnumerable<Comment> Comments => Device.Comment.Select(x => x.Comment).OfType<Comment>()
        .OrderByDescending(x => x.CommentedAtUtc).ThenByDescending(x => x.Id);

    private async Task OnAddCommentClicked()
    {
        if (_dialogOpen) return;
        _dialogOpen = true;
        var deviceId = Device.Id;
        try
        {
            var parameters = new DialogParameters<DeviceCommentDialog> { { x => x.DeviceId, deviceId } };
            var dialog = await Dialog.ShowAsync<DeviceCommentDialog>(UiText.Get(LocKeys.Ui.DeviceCommentsTab.AddComment), parameters,
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false, CloseOnEscapeKey = false });
            var result = await dialog.Result;
            if (Device.Id == deviceId && result is { Canceled: false, Data: Comment comment })
                Device.Comment.Add(new DeviceComment { DeviceId = deviceId, CommentId = comment.Id, Comment = comment });
        }
        finally { _dialogOpen = false; }
    }
}
