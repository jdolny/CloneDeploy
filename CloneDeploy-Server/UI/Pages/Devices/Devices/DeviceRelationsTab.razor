@inject DeviceService Devices
@inject PolicyService Policies
@inject DeviceService DirectoryRelations
@inject AuthenticationStateProvider Authentication

<MudStack Spacing="3">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    @if (_policyError is not null)
    {
        <MudAlert Severity="Severity.Warning">@UiText.Get(LocKeys.Ui.DeviceRelationsTab.PoliciesAndActionsCouldNotBeLoaded0, (_policyError))</MudAlert>
    }
    @if (_directoryError is not null) { <MudAlert Severity="Severity.Warning">@_directoryError</MudAlert> }
    <MudText Typo="Typo.body2">@Loc[LocKeys.Ui.DeviceRelationsTab.DirectoryGroupsIncludeNestedMembershipDirectoryOUsShowThe]</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" aria-label="@Loc[LocKeys.Ui.DeviceRelationsTab.FilterRelationsByType]">
        @foreach (var kind in Kinds)
        {
            <MudChip T="string" Color="@(_kind == kind ? Color.Primary : Color.Default)"
                     Variant="@(_kind == kind ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => OnFilterClicked(kind))" aria-pressed="@(_kind == kind ? "true" : "false")">
                @UiText.Label(kind) (@(kind == "All" ? _rows.Count : _rows.Count(x => x.Kind == kind)))
            </MudChip>
        }
    </MudStack>
    <MudDataGrid T="DeviceRelation" Items="VisibleRows" Dense="true" Hover="true" Elevation="0"
                 Class="device-list-grid" HorizontalScrollbar="true" Loading="_loading"
                 RowsPerPage="@Constants.UI.DefaultPageSize" @bind-CurrentPage="_currentPage">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Loc[LocKeys.Device.Relations]</MudText>
            <MudSpacer />
            <MudButton OnClick="OnRefreshClicked" Disabled="_loading" StartIcon="@Icons.Material.Filled.Refresh">@Loc[LocKeys.Dashboard.Refresh]</MudButton>
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="@Loc[LocKeys.Ui.DeviceRelationsTab.SearchRelations]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="device-inventory-search" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Kind" Title="@Loc[LocKeys.StorageProvider.Type]" />
            <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Ui.DeviceRelationsTab.RelatedItem]">
                <CellTemplate>
                    @if (context.Item.Href is { } href)
                    {
                        <MudLink Href="@href">@context.Item.Name</MudLink>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Item.Name</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Details" Title="@Loc[LocKeys.Ui.DeviceRelationsTab.Connection]" />
            <TemplateColumn Title="@Loc[LocKeys.Ui.DeviceRelationsTab.IncludedBy]" Sortable="false">
                <CellTemplate>
                    <MudStack Spacing="1">
                        @foreach (var link in context.Item.RelatedThrough)
                        {
                            <MudLink Href="@link.Href">@link.Name</MudLink>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4">@(_loading ? UiText.Get(LocKeys.Ui.DeviceRelationsTab.LoadingRelations) : _error is not null ? UiText.Get(LocKeys.Ui.DeviceRelationsTab.RelationsAreUnavailableUseRefreshToTryAgain) : UiText.Get(LocKeys.Ui.DeviceRelationsTab.NoRelationsMatchThisViewTryAnotherTypeOr))</MudText>
        </NoRecordsContent>
        <PagerContent><MudDataGridPager T="DeviceRelation" /></PagerContent>
    </MudDataGrid>
</MudStack>

@code {
    [Parameter, EditorRequired] public Device Device { get; set; } = null!;
    private static readonly string[] Kinds = ["All", "Groups", "Policies", "Actions", "Tags", "Imaging", "Directory", "Directory groups", "Directory OUs"];
    private List<DeviceRelation> _rows = [];
    private string _kind = "All";
    private string? _search, _error, _policyError, _directoryError;
    private bool _loading;
    private int _currentPage;
    private int? _loadedId;
    private IEnumerable<DeviceRelation> VisibleRows => _rows.Where(x => (_kind == "All" || x.Kind == _kind) && x.Matches(_search));

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Device.Id) return;
        _loadedId = Device.Id;
        await OnRefreshClicked();
    }

    private async Task OnRefreshClicked()
    {
        if (_loading) return;
        _loading = true;
        _rows = [];
        _error = _policyError = _directoryError = null;
        _currentPage = 0;
        try
        {
            var device = await Devices.GetDetailsAsync(Device.Id, "relations");
            if (!device.Success)
            {
                _error = Loc[device.Error!.Code, device.Error.Args];
                return;
            }
            var policies = await Policies.GetEffectivePoliciesAsync(Device.Id);
            if (!policies.Success) _policyError = Loc[policies.Error!.Code, policies.Error.Args];
            _rows = DeviceRelation.Create(device.Data!, policies.Success ? policies.Data! : []);
            try
            {
                var directoryRows = await DirectoryRelations.ReadDirectoryRelationsAsync((await Authentication.GetAuthenticationStateAsync()).User, Device.Id);
                _rows.AddRange(directoryRows.Select(x => new DeviceRelation(x.Kind, x.Name, x.Details, null, [])));
            }
            catch (UnauthorizedAccessException) { _directoryError = UiText.Get(LocKeys.Ui.DeviceRelationsTab.YouDoNotHavePermissionToViewDirectoryRelations); }
            catch { _directoryError = UiText.Get(LocKeys.Ui.DeviceRelationsTab.DirectoryGroupsAndOUsCouldNotBeLoadedUse); }
        }
        finally { _loading = false; }
    }

    private void OnFilterClicked(string kind)
    {
        _kind = kind;
        _currentPage = 0;
    }

    private void OnSearchChanged(string? value)
    {
        _search = value;
        _currentPage = 0;
    }
}
