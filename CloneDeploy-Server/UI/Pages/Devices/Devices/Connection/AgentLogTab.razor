@inject IJSRuntime JS
@implements IAsyncDisposable
@inject AgentService Agents

<MudStack Spacing="2">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <MudTextField T="string" @bind-Value="_filter" Label="@Loc[LocKeys.Device.FilterLog]" Immediate="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"/>
        <MudButton OnClick="OnTogglePausedClicked"
                   StartIcon="@(_paused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)">@(_paused ? Loc[LocKeys.Device.Resume].Value : Loc[LocKeys.Device.Pause].Value)</MudButton>
        <MudButton OnClick="OnRefreshClicked" Disabled="_busy" StartIcon="@Icons.Material.Filled.Refresh">@Loc[LocKeys.Common.Refresh]</MudButton>
        <MudButton OnClick="DownloadAsync" Disabled="_downloading" StartIcon="@Icons.Material.Filled.Download">@(_downloading ? UiText.Get(LocKeys.Ui.AgentLogTab.Downloading) : UiText.Get(LocKeys.Ui.AgentLogTab.DownloadFullLog))</MudButton>
    </MudStack>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">@_error</MudAlert>
    }
    <MudText Typo="Typo.caption">@UiText.Get(LocKeys.Ui.AgentLogTab.LatestEntriesUTC01, ((_paused ? UiText.Get(LocKeys.Ui.BootLiveActivityTab.Paused) : UiText.Get(LocKeys.Ui.AgentLogTab.RefreshesEvery3Seconds))), ((_updated is null ? "" : UiText.Get(LocKeys.Ui.AgentLogTab.Updated0HHMmSs, (_updated)))))</MudText>
    <pre @ref="_console" class="agent-log" role="log" aria-label="@Loc[LocKeys.Device.AgentLogOutput]">@FilteredText</pre>
</MudStack>

@code {
    private void OnTogglePausedClicked() => _paused = !_paused;

    [Parameter] public int DeviceId { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    private ElementReference _console;
    private IJSObjectReference? _module;
    private string _text = "", _filter = "";
    private string? _error;
    private DateTime? _updated;
    private bool _busy, _paused, _disposed, _downloading;

    private string FilteredText => string.IsNullOrWhiteSpace(_filter)
        ? _text
        : string.Join("\n", _text.Split('\n').Where(x => x.Contains(_filter, StringComparison.OrdinalIgnoreCase)));

    private async Task DownloadAsync()
    {
        if (_downloading || _disposed) return;
        _downloading = true;
        try
        {
            var result = await Agents.DownloadLogAsync(DeviceId, _stop.Token);
            if (_disposed) return;
            if (!result.HasData)
            {
                Snackbar.Add(UiText.Get(LocKeys.Ui.AgentLogTab.UnableToDownloadTheFullLogCheckThatThe), Severity.Error);
                return;
            }
            using var stream = new MemoryStream(result.Data);
            using var reference = new DotNetStreamReference(stream);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/agentLog.js");
            await _module.InvokeVoidAsync("download", reference, $"agent-{DeviceId}.log");
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (JSException) { Snackbar.Add(UiText.Get(LocKeys.Ui.AgentLogTab.UnableToDownloadTheAgentLogPleaseTryAgain), Severity.Error); }
        finally { _downloading = false; }
    }

    protected override void OnInitialized() => _poll = PollAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/agentLog.js");
            if (!_paused && !_disposed) await _module.InvokeVoidAsync("follow", _console);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (!_stop.IsCancellationRequested)
            {
                if (!_paused) await OnRefreshClicked();
                await Task.Delay(TimeSpan.FromSeconds(3), _stop.Token);
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    private async Task OnRefreshClicked()
    {
        if (_busy || _disposed) return;
        _busy = true;
        try
        {
            var result = await Agents.ReadLogAsync(DeviceId, _stop.Token);
            if (!result.HasData)
            {
                _error = Loc[result.Error!.Code, result.Error.Args];
                if (result.Error.Code == ErrorKeys.Agent.Forbidden)
                {
                    _paused = true;
                    _text = "";
                    _updated = null;
                }

                return;
            }

            var reply = result.Data;
            _error = reply.Available ? null : reply.Detail;
            if (reply.Available)
            {
                _text = reply.Text;
                _updated = DateTime.UtcNow;
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        finally
        {
            _busy = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _stop.Cancel();
        if (_poll is not null) await _poll;
        _stop.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }
        }
    }

}
