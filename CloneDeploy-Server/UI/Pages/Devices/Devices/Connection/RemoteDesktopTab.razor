@using System.Security.Claims
@inject AgentService RemoteDesktop
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@inject IAuthorizationService Authorization
@inject AgentService RemoteRules
@implements IAsyncDisposable

<div class="remote-desktop-viewer">
<MudStack Spacing="2">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudSelect T="int" @bind-Value="_windowsSessionId" Label="@Loc[LocKeys.Ui.RemoteDesktopTab.DesktopSession]" Disabled="@(_session is not null || _busy || _loadingSessions)">
            <MudSelectItem T="int" Value="-1" Disabled="true">@Loc[LocKeys.Ui.RemoteDesktopTab.SelectASession]</MudSelectItem>
            @foreach (var session in _windowsSessions)
            {
                <MudSelectItem T="int" Value="session.Id" Disabled="@(!session.Available)">@(UiText.Get(LocKeys.Ui.RemoteDesktopTab.Text012ID3, (session.Connection), ((string.IsNullOrEmpty(session.UserName) ? UiText.Get(LocKeys.Ui.RemoteDesktopTab.SignInScreen) : session.UserName)), (session.State), (session.Id)))</MudSelectItem>
            }
        </MudSelect>
        <MudButton OnClick="@Snackbar.GuardAction(() => _session is not null || _loadingSessions || _busy, UiText.Get(LocKeys.Ui.RemoteDesktopTab.DisconnectTheCurrentRemoteDesktopSessionBeforeRefreshingSessions), OnRefreshSessionsClicked)" Disabled="@(_loadingSessions || _busy)">@Loc[LocKeys.Ui.RemoteDesktopTab.RefreshSessions]</MudButton>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudButton OnClick="@Snackbar.GuardAction(() => _busy || _session is not null || _windowsSessionId < 0 || _loadingSessions, _session is not null ? UiText.Get(LocKeys.Ui.RemoteDesktopTab.DisconnectTheCurrentRemoteDesktopSessionFirst) : UiText.Get(LocKeys.Ui.RemoteDesktopTab.SelectADesktopSessionBeforeStartingRemoteDesktop), OnStartViewingClicked)" Disabled="@(_busy || _loadingSessions)" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Ui.RemoteDesktopTab.StartViewing]</MudButton>
        <MudButton OnClick="@Snackbar.GuardAction(() => _session is null && !_busy, UiText.Get(LocKeys.Ui.RemoteDesktopTab.ThereIsNoActiveSessionToDisconnect), OnDisconnectClicked)" Color="Color.Error">@(_busy ? UiText.Get(LocKeys.Ui.RemoteDesktopTab.CancelRequest) : UiText.Get(LocKeys.Device.Disconnect))</MudButton>
        <MudSwitch T="bool" Value="_control" ValueChanged="SetControlAsync" Disabled="@(_session is null || !_canControl)" Color="Color.Primary">@Loc[LocKeys.Ui.RemoteDesktopTab.MouseAndKeyboard]</MudSwitch>
    </MudStack>
    <MudText Typo="Typo.caption">@_status</MudText>
    @if (_effective is not null) { <MudText Typo="Typo.caption">@UiText.Get(LocKeys.Ui.RemoteDesktopTab.AccessRule01, (_effective.Rule), (AgentService.RemoteAccessLabel(_effective.Mode)))</MudText> }
    <div class="remote-desktop-toolbar">
        <label title="@Loc[LocKeys.Ui.RemoteDesktopTab.LowerFrameRatesReduceBandwidthAndDeviceLoadThis]">@Loc[LocKeys.Ui.RemoteDesktopTab.FrameRate] <select data-frame-rate aria-label="@Loc[LocKeys.Ui.RemoteDesktopTab.FrameRate]" disabled>
            <option value="2">@Loc[LocKeys.Ui.RemoteDesktopTab.Text2FPS]</option>
            <option value="4">@Loc[LocKeys.Ui.RemoteDesktopTab.Text4FPS]</option>
            <option value="8" selected>@Loc[LocKeys.Ui.RemoteDesktopTab.Text8FPS]</option>
            <option value="16">@Loc[LocKeys.Ui.RemoteDesktopTab.Text16FPS]</option>
        </select></label>
        <label>@Loc[LocKeys.Ui.RemoteDesktopTab.Quality] <select data-quality aria-label="@Loc[LocKeys.Ui.RemoteDesktopTab.ViewingQuality]" disabled>
            <option value="low">@Loc[LocKeys.Ui.RemoteDesktopTab.LowBandwidth]</option>
            <option value="balanced" selected>@Loc[LocKeys.Ui.RemoteDesktopTab.Balanced]</option>
            <option value="high">@Loc[LocKeys.Ui.RemoteDesktopTab.HighQuality]</option>
        </select></label>
        <label>@Loc[LocKeys.Ui.RemoteDesktopTab.Monitor] <select data-monitor aria-label="@Loc[LocKeys.Ui.RemoteDesktopTab.Monitor]" disabled></select></label>
        @if (!IsMac) { <button type="button" disabled="@(!_canControl)" data-sas @onclick="ExplainDisconnectedAction">@Loc[LocKeys.Ui.RemoteDesktopTab.CtrlAltDelete]</button> }
        <button type="button" disabled="@(!_canControl)" data-send-clipboard @onclick="ExplainDisconnectedAction">@Loc[LocKeys.Ui.RemoteDesktopTab.SendClipboard]</button>
        <button type="button" disabled="@(!_canControl)" data-get-clipboard @onclick="ExplainDisconnectedAction">@Loc[LocKeys.Ui.RemoteDesktopTab.GetClipboard]</button>
        <button type="button" data-fullscreen title="@Loc[LocKeys.Ui.RemoteDesktopTab.ViewTheRemoteDesktopFullscreenPressEscToExit]" @onclick="ExplainDisconnectedAction">@Loc[LocKeys.Ui.RemoteDesktopTab.Fullscreen]</button>
    </div>
    <div data-command-status role="status" aria-live="polite"></div>
    <details data-clipboard-panel>
        <summary>@Loc[LocKeys.Ui.RemoteDesktopTab.TextClipboard]</summary>
        <textarea data-clipboard-text aria-label="@Loc[LocKeys.Ui.RemoteDesktopTab.ClipboardText]" maxlength="16384" placeholder="Paste text here if browser clipboard access is unavailable."></textarea>
        <div class="remote-desktop-toolbar">
            <button type="button" disabled="@(!_canControl)" data-send-text @onclick="ExplainDisconnectedAction">@Loc[LocKeys.Ui.RemoteDesktopTab.SendText]</button>
            <button type="button" data-copy-text @onclick="ExplainDisconnectedAction">@Loc[LocKeys.Ui.RemoteDesktopTab.CopyTextLocally]</button>
        </div>
    </details>
    <canvas @ref="_canvas" tabindex="0" aria-label="@Loc[LocKeys.Ui.RemoteDesktopTab.RemoteDesktop]" style="width:100%;max-height:70vh;object-fit:contain;background:#111;outline:2px solid transparent;touch-action:none;"></canvas>
</MudStack>
</div>

@code {
    [Parameter] public bool IsMac { get; set; }
    [Parameter] public int DeviceId { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RemoteDesktopTab>? _reference;
    private Guid? _session;
    private bool _canControl, _control, _busy, _disposed;
    private string _status = UiText.Get(LocKeys.Ui.RemoteDesktopTab.NotConnected);
    private CloneDeploy_Agent.Contracts.AgentDesktopSession[] _windowsSessions = [];
    private int _windowsSessionId = -1;
    private bool _loadingSessions;
    private RemoteAccessEffective? _effective;
    private CancellationTokenSource? _requestStop;
    protected override async Task OnInitializedAsync() => await OnRefreshSessionsClicked();
    private async Task OnRefreshSessionsClicked()
    {
        _loadingSessions = true;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            _canControl = (await Authorization.AuthorizeAsync(user, Constants.Permissions.DeviceRemoteControl)).Succeeded;
            _windowsSessions = await RemoteDesktop.ListRemoteDesktopSessionsAsync(user, DeviceId, _stop.Token);
            _effective = await RemoteRules.RemoteAccessEffectiveAsync(user, DeviceId, _stop.Token);
            if (!_windowsSessions.Any(x => x.Id == _windowsSessionId && x.Available))
                _windowsSessionId = _windowsSessions.FirstOrDefault(x => x.Connection == "Console" && x.Available)?.Id ?? -1;
            _status = "";
        }
        catch { _status = UiText.Get(LocKeys.Ui.RemoteDesktopTab.CouldNotListDesktopSessions); }
        finally { _loadingSessions = false; }
    }

    private async Task OnStartViewingClicked()
    {
        if (_busy || _disposed || _session is not null) return;
        _busy = true;
        _status = UiText.Get(LocKeys.Ui.RemoteDesktopTab.RequestingRemoteAccessWaitingForApprovalIfRequiredUp);
        _requestStop = CancellationTokenSource.CreateLinkedTokenSource(_stop.Token);
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/remoteDesktop.js");
            if (!await _module.InvokeAsync<bool>("ensureSession", user.FindFirstValue(ClaimTypes.NameIdentifier))) return;
            _session = await RemoteDesktop.StartRemoteDesktopSessionAsync(user, DeviceId, _windowsSessionId, _requestStop.Token);
            if (_disposed) { await RemoteDesktop.StopRemoteDesktopAsync(user, _session.Value); return; }
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/remoteDesktop.js");
            _reference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("connect", _canvas, _session.Value.ToString(), _reference);
        }
        catch (Exception ex)
        {
            await OnDisconnectClicked();
            _status = ex is OperationCanceledException ? UiText.Get(LocKeys.Ui.RemoteDesktopTab.RemoteAccessRequestCancelledOrTimedOut) : ex is InvalidOperationException ? ex.Message : UiText.Get(LocKeys.Ui.RemoteDesktopTab.CouldNotStartRemoteViewingCheckTheAgentConnection);
        }
        finally { _busy = false; _requestStop?.Dispose(); _requestStop = null; }
    }

    private async Task SetControlAsync(bool value)
    {
        value = value && _canControl;
        _control = value;
        if (_module is not null) await _module.InvokeVoidAsync("setControl", _canvas, value);
    }
    private void ExplainDisconnectedAction()
    {
        if (_session is null) Snackbar.Add(UiText.Get(LocKeys.Ui.RemoteDesktopTab.StartViewingADesktopSessionBeforeUsingRemoteDesktop), Severity.Error);
    }

    [JSInvokable]
    public Task ShowActionError(string message) => InvokeAsync(() =>
    {
        if (!_disposed) Snackbar.Add(message, Severity.Error);
    });

    [JSInvokable]
    public async Task ConnectionChanged(bool connected, string detail)
    {
        if (_disposed) return;
        if (!connected) await OnDisconnectClicked();
        _status = detail;
        await InvokeAsync(StateHasChanged);
    }
    private async Task OnDisconnectClicked()
    {
        _requestStop?.Cancel();
        var id = _session; _session = null; _control = false;
        if (_module is not null)
            try { await _module.InvokeVoidAsync("disconnect", _canvas); }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or JSException) { }
        if (id is not null)
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            await RemoteDesktop.StopRemoteDesktopAsync(user, id.Value);
        }
        _status = "Disconnected.";
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _stop.Cancel();
        await OnDisconnectClicked();
        _reference?.Dispose();
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
