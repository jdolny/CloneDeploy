@inject AgentService Boot
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_busy) { <MudProgressLinear Indeterminate="true" /> }
            @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            @if (_review is not null)
            {
                <MudText Typo="Typo.h6">@_review.DeviceName</MudText>
                <MudText><b>@Loc[LocKeys.Ui.DeviceDeploymentSettingsTab.Image]</b> @_review.ImageName</MudText>
                <MudText><b>@Loc[LocKeys.Ui.AgentImagingBootDialog.ImageProfile]</b> @_review.ProfileName</MudText>
                <MudText><b>@Loc[LocKeys.Ui.AgentImagingBootDialog.WinPEBootEnvironment]</b> @_review.VariantName (@_review.Architecture) — @_review.MatchReason</MudText>
                <MudText Typo="Typo.caption">@UiText.Get(LocKeys.Ui.AgentImagingBootDialog.Build0, (_review.BuildId))</MudText>
                @if (_check is not null) { <MudAlert Severity="@(_check.Success ? Severity.Success : Severity.Error)">@_check.Detail</MudAlert> }
                <MudAlert Severity="Severity.Warning">@Loc[LocKeys.Ui.AgentImagingBootDialog.ThisDownloadsWinPERestartsTheComputerAfterA60]</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClicked" Disabled="_busy">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton OnClick="OnReloadReviewClicked" Disabled="_busy">@Loc[LocKeys.Ui.AgentImagingBootDialog.ReloadReview]</MudButton>
        <MudButton OnClick="@Snackbar.GuardAction(() => _busy || _check?.Success != true, _check?.Detail ?? UiText.Get(LocKeys.Ui.AgentImagingBootDialog.ReloadTheDeploymentReviewAndCompleteTheReadinessCheck), OnDeployAndRestartClicked)" Color="Color.Error" Variant="Variant.Filled" Disabled="@(_busy)">@Loc[LocKeys.Ui.AgentImagingBootDialog.DeployAndRestart]</MudButton>
    </DialogActions>
</MudDialog>
@code {
    private void OnCancelClicked() => MudDialog.Cancel();

    [Parameter] public int DeviceId { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private AgentImagingReview? _review;
    private AgentImagingReply? _check;
    private string? _error;
    private bool _busy;
    protected override Task OnInitializedAsync() => OnReloadReviewClicked();
    private async Task OnReloadReviewClicked()
    {
        _busy = true; _error = null; _check = null; _review = null;
        try { _review = await Boot.ReviewImagingBootAsync(DeviceId); _check = await Boot.CheckImagingBootAsync(_review); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task OnDeployAndRestartClicked()
    {
        if (_busy || _review is null || _check?.Success != true) return;
        _busy = true;
        try { var id = await Boot.StartImagingBootAsync(_review); Snackbar.Add(UiText.Get(LocKeys.Ui.AgentImagingBootDialog.AgentImagingRequestedFollowProgressInImagingTasks), Severity.Success); MudDialog.Close(DialogResult.Ok(id)); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _check = null; }
        finally { _busy = false; }
    }
}
