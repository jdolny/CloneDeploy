<a class="dashboard-metric" href="@Href" aria-label="@($"{Title}: {Count:N0}. {Description}")">
    <MudPaper Elevation="2" Class="pa-5 metric-card" Style="height:100%">
        <div class="metric-icon" style="--metric-color:var(--mud-palette-@(Color.ToString().ToLowerInvariant()))"><MudIcon Icon="@Icon" Color="@Color" /></div>
        <div class="metric-copy">
            <MudText Typo="Typo.subtitle2">@Title</MudText>
            <MudText Typo="Typo.h3" Class="my-1">@Count.ToString("N0")</MudText>
            <MudText Typo="Typo.caption">@Description</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" Size="Size.Small" />
    </MudPaper>
</a>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public int Count { get; set; }
    [Parameter] public string Href { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
