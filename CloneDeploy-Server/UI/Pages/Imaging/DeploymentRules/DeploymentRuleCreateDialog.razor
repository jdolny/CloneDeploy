@inject ImagingService Deployments
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Disabled="_busy">
            <MudTextField @bind-Value="_rule.Name" Label="@Loc[LocKeys.Common.Name]" Required="true" MaxLength="100" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_rule.Description" Label="@Loc[LocKeys.Common.Description]" Lines="3" Variant="Variant.Outlined" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClicked" Disabled="_busy">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton OnClick="OnCreateClicked" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Common.Create]</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;
    private readonly AutomaticDeploymentRule _rule = new();
    private bool _busy;

    private void OnCancelClicked() => MudDialog.Cancel();

    private async Task OnCreateClicked()
    {
        if (_busy) return;
        _busy = true;

        try
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
            await Deployments.SaveAutomaticRuleGeneralAsync(_rule);
            MudDialog.Close(DialogResult.Ok(_rule.Id));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
