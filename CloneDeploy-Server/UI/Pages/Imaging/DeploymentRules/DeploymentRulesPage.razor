@page "/images/deploymentrules"
@attribute [Authorize(Policy = Constants.Permissions.DeploymentRuleView)]
@inject ImagingService Deployments
@inject AuthenticationStateProvider RuleAuthentication
@inject IAuthorizationService RuleAuthorization

<AppPageTitle Text="@Loc[LocKeys.Ui.NavMenu.DeploymentRules]" />
<ActionButtons>
    <MainButton><MudButton Disabled="!_canEdit" OnClick="OnCreateClicked" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">@Loc[LocKeys.Ui.DeploymentRulesPage.NewDeploymentRule]</MudButton></MainButton>
</ActionButtons>
<MudPaper Class="device-list-filters device-search-panel" Elevation="0">
    <div class="device-list-search-row">
        <div class="device-list-search">
            <MudTextField T="string" @bind-Value="_search" DebounceInterval="300" Placeholder="@Loc[LocKeys.Ui.DeploymentRulesPage.SearchDeploymentRules]" aria-label="@Loc[LocKeys.Ui.DeploymentRulesPage.SearchDeploymentRules_0ed308d4]"
                          Clearable="true" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Disabled="_busy" />
        </div>
        <div class="device-list-limit"><MudCheckBox @bind-Value="_includeDisabled" Label="@Loc[LocKeys.Image.IncludeDisabled]" Disabled="_busy" /></div>
    </div>
</MudPaper>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
<MudDataGrid T="AutomaticDeploymentRule" Items="VisibleRules" QuickFilter="MatchesSearch" Loading="_busy"
             Dense="true" Hover="true" Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterMenu" ColumnResizeMode="ResizeMode.Column"
             RowsPerPage="25" Elevation="0" Outlined="true" Class="device-list-grid">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.Rule" Color="Color.Primary" />
        <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.NavMenu.DeploymentRules]</MudText>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Common.Name]">
            <CellTemplate><MudLink Class="device-name-link" Href="@($"/images/deploymentrules/{context.Item.Id}")">@(string.IsNullOrWhiteSpace(context.Item.Name) ? UiText.Get(LocKeys.Ui.DeploymentRulesPage.NewDeploymentRule_9d3c30c3) : context.Item.Name)</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Enabled" Title="@Loc[LocKeys.StorageProvider.Enabled]" />
        <PropertyColumn Property='x => x.IsComplete ? "Complete" : "Incomplete"' Title="@Loc[LocKeys.Image.Configuration]" />
        <PropertyColumn Property="x => x.Priority" Title="@Loc[LocKeys.Device.Priority]" />
        <PropertyColumn Property="x => x.Manufacturer ?? x.ManufacturerRegex" Title="@Loc[LocKeys.Device.Manufacturer]" />
        <PropertyColumn Property="x => x.Model ?? x.ModelRegex" Title="@Loc[LocKeys.Device.Model]" />
        <PropertyColumn Property='x => x.ManufacturerRegex != null || x.ModelRegex != null ? "Regular expression" : "Exact"' Title="@Loc[LocKeys.Ui.DeploymentRulesPage.MatchType]" />
        <PropertyColumn Property="x => x.Image == null ? string.Empty : x.Image.Name" Title="@Loc[LocKeys.Device.Image]" />
        <PropertyColumn Property="x => x.DeploymentProfile == null ? string.Empty : x.DeploymentProfile.Name" Title="@Loc[LocKeys.Device.DeploymentProfile]" />
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" StickyRight="true" Sortable="false" Filterable="false">
            <CellTemplate><MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Common.Delete]"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" OnClick="@(() => Delete(context.Item))" Disabled="@(_busy || !_canEdit)" aria-label="@Loc[LocKeys.Ui.DeploymentRulesPage.DeleteDeploymentRule]" /></MudTooltip></CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="AutomaticDeploymentRule" /></PagerContent>
    <NoRecordsContent><MudText>@Loc[LocKeys.Ui.DeploymentRulesPage.NoMatchingDeploymentRules]</MudText></NoRecordsContent>
</MudDataGrid>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">@Loc[LocKeys.Ui.DeploymentRulesPage.RulesMatchADeviceSManufacturerAndModelAfter]</MudText>

@code {
    private bool _canEdit;
    private async Task OnCreateClicked()
    {
        var dialog = await Dialog.ShowAsync<DeploymentRuleCreateDialog>(UiText.Get(LocKeys.Ui.DeploymentRulesPage.NewDeploymentRule), new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false, Data: int id }) Navigation.NavigateTo($"/images/deploymentrules/{id}");
    }

    private bool _busy = true, _includeDisabled;
    private string? _search, _error;
    private List<AutomaticDeploymentRule> _rules = [];
    private IEnumerable<AutomaticDeploymentRule> VisibleRules => _rules.Where(x => _includeDisabled || x.Enabled);

    private bool MatchesSearch(AutomaticDeploymentRule rule) => string.IsNullOrWhiteSpace(_search) ||
        new[] { rule.Name, rule.Manufacturer, rule.Model, rule.ManufacturerRegex, rule.ModelRegex, rule.Image?.Name, rule.DeploymentProfile?.Name }
            .Any(value => value?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) == true);

    protected override async Task OnInitializedAsync()
    {
        _canEdit = (await RuleAuthorization.AuthorizeAsync((await RuleAuthentication.GetAuthenticationStateAsync()).User, Constants.Permissions.DeploymentRuleEdit)).Succeeded;
        try { _rules = await Deployments.GetAutomaticRulesAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete(AutomaticDeploymentRule rule)
    {
        if (_busy || await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.DeploymentRulesPage.DeleteDeploymentRule), UiText.Get(LocKeys.Ui.ManageImageProfilePage.Delete0, (rule.Name)), yesText: UiText.Get(LocKeys.Common.Delete), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true) return;
        _busy = true;
        _error = null;
        try
        {
            await Deployments.DeleteAutomaticRuleAsync(rule.Id);
            _rules.Remove(rule);
            Snackbar.Add(UiText.Get(LocKeys.Ui.DeploymentRulesPage.DeploymentRuleDeleted), Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
