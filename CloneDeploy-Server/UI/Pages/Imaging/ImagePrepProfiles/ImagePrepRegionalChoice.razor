<MudSelect T="string" Value="@Selection" ValueChanged="SelectAsync" Label="@Label" Disabled="Disabled" Variant="Variant.Outlined" HelperText="@HelperText">
    <MudSelectItem T="string" Value="@(string.Empty)">@Loc[LocKeys.Ui.ImagePrepRegionalChoice.WindowsDefault]</MudSelectItem>
    @foreach (var option in Options)
    {
        <MudSelectItem T="string" Value="@option.Value">@option.Label (@option.Value)</MudSelectItem>
    }
    <MudSelectItem T="string" Value="@Custom">@Loc[LocKeys.Ui.ImagePrepRegionalChoice.CustomValue]</MudSelectItem>
</MudSelect>
@if (Selection == Custom)
{
    <MudTextField T="string" Value="@Value" ValueChanged="ValueChanged" Label="@(UiText.Get(LocKeys.Ui.ImagePrepRegionalChoice.Custom0, (Label.ToLowerInvariant())))" Placeholder="@Placeholder" Disabled="Disabled" Variant="Variant.Outlined" />
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ImagePrepRegionalOptions.Choice> Options { get; set; } = [];
    [Parameter] public string Label { get; set; } = UiText.Get(LocKeys.Ui.ImagePrepRegionalChoice.RegionalSetting);
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private const string Custom = "__custom";
    private bool _custom;
    private string Selection => _custom || (!string.IsNullOrEmpty(Value) && !Options.Any(x => x.Value == Value))
        ? Custom : Value ?? string.Empty;

    private async Task SelectAsync(string selection)
    {
        _custom = selection == Custom;
        if (!_custom) await ValueChanged.InvokeAsync(string.IsNullOrEmpty(selection) ? null : selection);
    }
}
