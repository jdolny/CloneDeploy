@page "/images/prepprofiles"
@attribute [Authorize(Policy = Constants.Permissions.ImagePrepProfileView)]
@inject ImagingService Profiles

<ImagingEditScope Policy="@Constants.Permissions.ImagePrepProfileEdit" Context="canEditImage">
<AppPageTitle Text="@Loc[LocKeys.Ui.NavMenu.ImagePrepProfiles]" />
<ActionButtons>
    <MainButton>
        <MudButton Disabled="@(!canEditImage)" OnClick="OnCreateClicked" StartIcon="@Icons.Material.Filled.Add">@Loc[LocKeys.Ui.ImagePrepProfilesPage.NewImagePrepProfile]</MudButton>
    </MainButton>
</ActionButtons>

<MudPaper Class="device-list-filters device-search-panel" Elevation="0">
    <div class="device-list-search-row">
        <div class="device-list-search">
            <MudTextField T="string" @bind-Value="_search" DebounceInterval="300" Placeholder="@Loc[LocKeys.Ui.ImagePrepProfilesPage.SearchProfiles]"
                          Clearable="true" Margin="Margin.Dense" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" />
        </div>
        <div class="device-list-limit">
            <MudCheckBox @bind-Value="_includeDisabled" Label="@Loc[LocKeys.Image.IncludeDisabled]" />
        </div>
    </div>
</MudPaper>

<MudDataGrid T="ImagePrepProfile" Items="FilteredItems" Loading="_loading" Dense="true" Hover="true"
             Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterMenu" ColumnResizeMode="ResizeMode.Column"
             RowsPerPage="25" Elevation="0" Outlined="true" Class="device-list-grid">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.Build" Color="Color.Primary" />
        <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.NavMenu.ImagePrepProfiles]</MudText>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Common.Name]">
            <CellTemplate>
                <MudLink Class="device-name-link" Href="@($"/images/prepprofiles/{context.Item.Id}")">@context.Item.Name</MudLink>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Description" Title="@Loc[LocKeys.Common.Description]" />
        <PropertyColumn Property="x => x.Enabled" Title="@Loc[LocKeys.StorageProvider.Enabled]" />
        <PropertyColumn Property="x => x.RunSysprep" Title="@Loc[LocKeys.Ui.ImagePrepProfilesPage.RunSysprep]" />
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" StickyRight="true" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Common.Delete]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary"
                                   OnClick="@(() => DeleteAsync(context.Item))" Disabled="@(!canEditImage || (_busy))" aria-label="@Loc[LocKeys.Ui.ImagePrepProfilesPage.DeleteProfile]" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="ImagePrepProfile" /></PagerContent>
    <NoRecordsContent><MudText>@Loc[LocKeys.Ui.ImagePrepProfilesPage.NoImagePrepProfilesFound]</MudText></NoRecordsContent>
</MudDataGrid>


</ImagingEditScope>
@code {
    private async Task OnCreateClicked()
    {
        var dialog = await Dialog.ShowAsync<ImagePrepProfileCreateDialog>(UiText.Get(LocKeys.Ui.ImagePrepProfilesPage.NewImagePrepProfile), new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false, Data: int id })
            Navigation.NavigateTo($"/images/prepprofiles/{id}");
    }

    private List<ImagePrepProfile> _items = [];
    private string? _search;
    private bool _includeDisabled, _busy;
    private bool _loading = true;

    private IEnumerable<ImagePrepProfile> FilteredItems => _items.Where(x =>
        (_includeDisabled || x.Enabled) && (string.IsNullOrWhiteSpace(_search)
            || $"{x.Name} {x.Description}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Profiles.GetImagePrepProfilesAsync();
        _items = result.Data ?? [];
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _loading = false;
    }

    private async Task DeleteAsync(ImagePrepProfile profile)
    {
        if (_busy || await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.ImagePrepProfilesPage.DeleteImagePrepProfile), UiText.Get(LocKeys.Ui.ManageImageProfilePage.Delete0, (profile.Name)),
                yesText: UiText.Get(LocKeys.Common.Delete), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true)
            return;

        _busy = true;
        try
        {
            var result = await Profiles.DeleteImagePrepAsync(profile.Id);
            if (!result.Success)
                Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
