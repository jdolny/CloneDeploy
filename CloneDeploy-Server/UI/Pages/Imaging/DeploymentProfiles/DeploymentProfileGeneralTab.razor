@inject ImagingService ImagingService
<ImagingEditScope Policy="@Constants.Permissions.DeploymentProfileEdit" Context="canEditImage">
@if (_model is null)
{
    @if (_loadingModel) { <MudProgressLinear Indeterminate="true"/> }
    else { <MudAlert Severity="Severity.Error">@Loc[LocKeys.Ui.DeploymentDriversTab.UnableToLoadSettingsReopenThisTabToTry]</MudAlert> }
}
else
{
<div class="section-action-bar"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!canEditImage || (_saving))" OnClick="OnSaveClicked">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton></div>

<div>
    <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.User.General]</MudText>
    <MudForm @ref="_form" Disabled="@(!canEditImage || (_saving))"><MudGrid><MudItem xs="12" md="12">
        <MudTextField Disabled="@(!canEditImage)" @bind-Value="_model.Name" Label="@Loc[LocKeys.Common.Name]" Required="true" MaxLength="200" Variant="Variant.Outlined" />
        <MudTextField Disabled="@(!canEditImage)" @bind-Value="_model.Description" Label="@Loc[LocKeys.Common.Description]" Lines="3" Variant="Variant.Outlined" />
    </MudItem></MudGrid></MudForm>
</div>

}

</ImagingEditScope>
@code {
    private DeploymentProfile _model = null!;
    private bool _loadingModel = true;
    protected override async Task OnInitializedAsync()
    {
        var result = await ImagingService.GetProfileByIdAsync(Profile.Id);
        if (result.Success && result.HasData) { _model = result.Data; await LoadOptionsAsync(); }
        else if (!result.Success) Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _loadingModel = false;
    }

    private Task LoadOptionsAsync() => Task.CompletedTask;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter, EditorRequired] public DeploymentProfile Profile { get; set; } = null!;
    private MudForm _form = null!;
    private bool _saving;
    private async Task OnSaveClicked()
    {
        if (_saving) return;
        await _form.ValidateAsync(); if (!_form.IsValid) return;
        _saving = true;
        var result = await ImagingService.SaveProfileGeneralAsync(_model);
        if (result.Success) await OnSaved.InvokeAsync();
        Snackbar.Add(result.Success ? UiText.Get(LocKeys.Action.GeneralSaved) : Loc[result.Error!.Code, result.Error.Args], result.Success ? Severity.Success : Severity.Error);
        _saving = false;
    }
}
