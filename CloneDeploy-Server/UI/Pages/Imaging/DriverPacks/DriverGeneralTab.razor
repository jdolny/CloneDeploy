@inject AuthenticationStateProvider SharedCatalogAuthentication
@inject IAuthorizationService SharedCatalogAuthorization
@inject DriverService Service
@inject ImagingService ImagingService
<ImagingEditScope Policy="@Constants.Permissions.DriverPackEdit" Context="canEditImage">
@if (_loading) { <MudProgressLinear Indeterminate="true"/> }
else if (_entity is not null)
{
<div class="section-action-bar"><MudButton OnClick="OnSaveGeneralClicked" Disabled="@(!canEditImage || (_busy))" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton></div>
    <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.User.General]</MudText>
<MudForm @ref="_form" Disabled="@(!canEditImage || (_busy))">
                    <MudStack Spacing="3">
                        <MudTextField Disabled="@(!canEditImage)" @bind-Value="_entity.Name" Label="@Loc[LocKeys.Common.Name]" Required="true" MaxLength="200" Variant="Variant.Outlined" />
                        <MudTextField Disabled="@(!canEditImage)" @bind-Value="_entity.Description" Label="@Loc[LocKeys.Common.Description]" Lines="3" Variant="Variant.Outlined" />
                        <MudText Typo="Typo.subtitle2">@Loc[LocKeys.Common.Tags]</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            @foreach (var id in _tagIds) { <MudChip T="int" Value="id" Color="Color.Primary" Variant="Variant.Outlined" Disabled="_busy" OnClose="@(() => OnRemoveTag(id))">@(_tags.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString())</MudChip> }
                        </MudStack>
                        <MudAutocomplete T="Tag" @ref="_tagPicker" Label="@Loc[LocKeys.Image.AddTag]" SearchFunc="SearchTags" ToStringFunc="@(tag => tag?.Name ?? "")" ValueChanged="OnAddTag" Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true" Disabled="_busy"/>


                    </MudStack>
                </MudForm>

}
@if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }

</ImagingEditScope>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    private DriverPack? _entity;
    private bool _loading = true, _busy;
    private string? _error;
    private MudForm _form = null!;
    private List<Tag> _tags = [];
    private IReadOnlyCollection<int> _tagIds = [];
    private MudAutocomplete<Tag> _tagPicker = null!;
    private Task<IEnumerable<Tag>> SearchTags(string? text, CancellationToken ct) => Task.FromResult(_tags.Where(x => !_tagIds.Contains(x.Id) && (string.IsNullOrWhiteSpace(text) || x.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase))));
    private async Task OnAddTag(Tag? tag) { if (_busy || tag is null) return; _tagIds = _tagIds.Append(tag.Id).Distinct().ToArray(); await _tagPicker.ClearAsync(); }
    private void OnRemoveTag(int id) { if (!_busy) _tagIds = _tagIds.Where(x => x != id).ToArray(); }
    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(Id);
        _entity = result.Data;
        if (!result.Success) _error = Loc[result.Error!.Code, result.Error.Args];
        if (_entity is not null)
        {
            var tags = ((await SharedCatalogAuthorization.AuthorizeAsync((await SharedCatalogAuthentication.GetAuthenticationStateAsync()).User, Constants.Permissions.TagView)).Succeeded ? await ImagingService.GetTagsAsync() : ServiceResult<List<Tag>>.Ok([])); _tags = tags.Data ?? [];
            if (!tags.Success) _error = Loc[tags.Error!.Code, tags.Error.Args];
            _tagIds = _entity.Tags.Select(x => x.TagId).ToArray();
        }
        _loading = false;
    }
    private async Task OnSaveGeneralClicked()
    {
        if (_busy || _entity is null) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _busy = true; _error = null;
        _entity.Tags = _tagIds.Select(id => new DriverProfileTag { DriverProfileId = Id, TagId = id }).ToList();
        var result = await Service.SaveGeneralAsync(_entity);
        if (result.Success)
        {
            _entity.Name = _entity.Name.Trim(); _entity.Description = _entity.Description?.Trim();
            Snackbar.Add(UiText.Get(LocKeys.Action.GeneralSaved), Severity.Success);
            await OnSaved.InvokeAsync();
        }
        else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
        _busy = false;
    }
}
