@inject DriverService Service
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Disabled="_busy">
            <MudTextField @bind-Value="_name" Label="@Loc[LocKeys.Common.Name]" Required="true" MaxLength="200" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_description" Label="@Loc[LocKeys.Common.Description]" Lines="3" Variant="Variant.Outlined" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClicked" Disabled="_busy">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton OnClick="OnCreateClicked" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Common.Create]</MudButton>
    </DialogActions>
</MudDialog>
@code {
    private void OnCancelClicked() => MudDialog.Cancel();
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;
    private string _name = "";
    private string? _description;
    private bool _busy;
    private async Task OnCreateClicked()
    {
        if (_busy) return;
        await _form.ValidateAsync(); if (!_form.IsValid) return;
        _busy = true;
        var result = await Service.CreateAsync(_name, _description);
        if (result.Success) MudDialog.Close(DialogResult.Ok(result.Data!.Id));
        else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
        _busy = false;
    }
}
