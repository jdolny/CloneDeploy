@inject DriverService Service
@inject ImagingService ImagingService
<ImagingEditScope Policy="@Constants.Permissions.DriverPackEdit" Context="canEditImage">
@if (_loading) { <MudProgressLinear Indeterminate="true"/> }
else if (_entity is not null)
{
<div class="section-action-bar"><MudButton OnClick="OnSaveConfigurationClicked" Disabled="@(!canEditImage || (_busy))" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton></div>
    <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.Image.Configuration]</MudText>
<MudStack Spacing="3">
                    <MudCheckBox T="bool" @bind-Value="_entity.Enabled" Disabled="@(!canEditImage || (_busy))" Label="@Loc[LocKeys.StorageProvider.Enabled]" />
                    <MudSelect T="int?" @bind-Value="_entity.UpdateScheduleId" Label="@Loc[LocKeys.Ui.DriverConfigurationTab.AutomaticDownloadSchedule]" Disabled="@(!canEditImage || (_busy))" Clearable="true" Variant="Variant.Outlined">
                        @foreach (var schedule in _schedules) { <MudSelectItem T="int?" Value="@((int?)schedule.Id)">@schedule.Name</MudSelectItem> }
                    </MudSelect>
                    <MudText Typo="Typo.body2">@Loc[LocKeys.Ui.DriverConfigurationTab.ScheduledChecksFollowNewerVendorReleasesOnlyForFiles]</MudText>

                </MudStack>

}
@if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }

</ImagingEditScope>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    private DriverPack? _entity;
    private bool _loading = true, _busy;
    private string? _error;
    private List<Schedule> _schedules = [];
    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(Id);
        _entity = result.Data;
        if (!result.Success) _error = Loc[result.Error!.Code, result.Error.Args];
        if (_entity is not null)
        {
            var schedules = await Service.GetSchedulesAsync(); _schedules = schedules.Data ?? [];
            if (!schedules.Success) _error = Loc[schedules.Error!.Code, schedules.Error.Args];
        }
        _loading = false;
    }
    private async Task OnSaveConfigurationClicked()
    {
        if (_busy || _entity is null) return;
        _busy = true; _error = null;
        var result = await Service.SaveConfigurationAsync(_entity);
        if (result.Success) { Snackbar.Add(UiText.Get(LocKeys.Image.ConfigurationUpdated), Severity.Success); }
        else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
        _busy = false;
    }
}
