@inject AuthenticationStateProvider SharedCatalogAuthentication
@inject IAuthorizationService SharedCatalogAuthorization
@inject ImagingService ImagingService
<ImagingEditScope Policy="@Constants.Permissions.ImageEdit" Context="canEditImage">
@if (_model is null)
{
    @if (_loadingModel) { <MudProgressLinear Indeterminate="true"/> }
    else { <MudAlert Severity="Severity.Error">@Loc[LocKeys.Ui.DeploymentDriversTab.UnableToLoadSettingsReopenThisTabToTry]</MudAlert> }
}
else
{
<div class="section-action-bar"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!canEditImage || (_saving || _loading))" OnClick="@(OnSaveClicked)">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton></div>



@if (_loading)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <div>
        <MudForm Disabled="@(!canEditImage)" @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="12">
                    <MudTextField Disabled="@(!canEditImage)" @bind-Value="_model.Name" Label="@Loc[LocKeys.Common.Name]" Variant="Variant.Outlined" Required="true" MaxLength="200"/>
                    <MudTextField Disabled="@(!canEditImage)" @bind-Value="_model.Description" Label="@Loc[LocKeys.Common.Description]" Variant="Variant.Outlined" Lines="3"/>
                    <MudTextField T="string" Value="@(_model.Format == ImageFormat.Ffu ? UiText.Get(LocKeys.Ui.ImageCreateDialog.FFUWholeDisk) : UiText.Get(LocKeys.Ui.ImageCreateDialog.WIMWindowsPartition))"
                                  Label="@Loc[LocKeys.Ui.ImageCreateDialog.ImageType]" Variant="Variant.Outlined" ReadOnly="true"/>
                    <MudSwitch @bind-Value="_model.Enabled" Label="@Loc[LocKeys.Image.Enabled]" Color="Color.Primary" Disabled="@(!canEditImage || (_saving))"/>
                    <MudSwitch @bind-Value="_model.Protected" Label="@Loc[LocKeys.Image.Protected]" Color="Color.Primary" Disabled="@(!canEditImage || (_saving))"/>
                    <MudText Typo="Typo.body2">@Loc[LocKeys.Image.ProtectionHint]</MudText>
                                </MudItem>
                <MudItem xs="12" md="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc[LocKeys.Common.Tags]</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                        @foreach (var id in _tagIds)
                        {
                            var name = _tags.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString();
                            <MudChip T="int" @key="id" Value="id" Color="Color.Primary" Variant="Variant.Outlined"
                                     Disabled="_saving" OnClose="@(() => OnRemoveTag(id))">@name</MudChip>
                        }
                    </MudStack>
                    <MudAutocomplete T="Tag" @ref="_tagPicker" Label="@Loc[LocKeys.Image.AddTag]" Variant="Variant.Outlined"
                                     SearchFunc="SearchTags" ToStringFunc="@(tag => tag?.Name ?? string.Empty)" ValueChanged="OnAddTag"
                                     Clearable="true" ResetValueOnEmptyText="true" MaxItems="20" Disabled="_saving"
                                     AdornmentIcon="@Icons.Material.Filled.Search"/>
</MudItem>
            </MudGrid>
        </MudForm>
    </div>
    <div>
        <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.Image.Content]</MudText>
        <MudText>@Loc[_model.LastUploadGuid == Guid.Empty ? LocKeys.Image.NotUploaded : LocKeys.Image.Uploaded]</MudText>
        @if (_model.LastUploadGuid != Guid.Empty)
        {
            <MudText Typo="Typo.caption">@Loc[LocKeys.Image.LastUpload, _model.LastUploadGuid]</MudText>
        }
    </div>
}


}

</ImagingEditScope>
@code {
    private Image _model = null!;
    private bool _loadingModel = true;
    protected override async Task OnInitializedAsync()
    {
        var result = await ImagingService.GetImageAsync(Image.Id);
        if (result.Success && result.HasData) { _model = result.Data; await LoadOptionsAsync(); }
        else if (!result.Success) Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _loadingModel = false;
    }

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter, EditorRequired] public Image Image { get; set; } = null!;

    private MudForm _form = null!;
    private List<Tag> _tags = [];
    private MudAutocomplete<Tag> _tagPicker = null!;
    private IReadOnlyCollection<int> _tagIds = [];
    private bool _loading = true;
    private bool _saving;

    private async Task LoadOptionsAsync()
    {
        _loading = true;
        _tagIds = _model.Tags.Select(x => x.TagId).ToArray();

        var result = ((await SharedCatalogAuthorization.AuthorizeAsync((await SharedCatalogAuthentication.GetAuthenticationStateAsync()).User, Constants.Permissions.TagView)).Succeeded ? await ImagingService.GetTagsAsync() : ServiceResult<List<Tag>>.Ok([]));
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        else if (result.HasData)
            _tags = result.Data;

        _loading = false;
    }

    private Task<IEnumerable<Tag>> SearchTags(string? text, CancellationToken cancellationToken)
    {
        return Task.FromResult(_tags.Where(x => !_tagIds.Contains(x.Id) &&
            (string.IsNullOrWhiteSpace(text) || x.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase))));
    }

    private async Task OnAddTag(Tag? tag)
    {
        if (_saving || tag is null) return;
        _tagIds = _tagIds.Append(tag.Id).Distinct().ToArray();
        await _tagPicker.ClearAsync();
    }

    private void OnRemoveTag(int id)
    {
        if (_saving) return;
        _tagIds = _tagIds.Where(x => x != id).ToArray();
    }

    private async Task OnSaveClicked()
    {
        if (_saving || _loading) return;
        _saving = true;
        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            _saving = false;
            return;
        }

        _model.Tags = _tagIds.Select(id => new ImageTag { ImageId = _model.Id, TagId = id }).ToList();
        var result = await ImagingService.SaveImageGeneralAsync(_model);
        if (result.Success)
        {
            await OnSaved.InvokeAsync();
            _model.Name = _model.Name.Trim();
            _model.Description = _model.Description?.Trim();
            Snackbar.Add(Loc[LocKeys.Common.Updated, _model.Name!], Severity.Success);
        }
        else
            Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);

        _saving = false;
    }

}
