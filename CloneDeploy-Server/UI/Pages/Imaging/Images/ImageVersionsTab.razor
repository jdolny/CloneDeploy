@inject ImagingService ImagingService


<ImagingEditScope Policy="@Constants.Permissions.ImageEdit" Context="canEditImage">
<MudDataGrid T="ImageVersion" Items="_versions" Loading="_loading" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="device-list-grid"
             RowsPerPage="@Constants.UI.DefaultPageSize"
             QuickFilter="@(x => string.IsNullOrWhiteSpace(_gridSearch0) || (x.Name).Contains(_gridSearch0.Trim(), StringComparison.OrdinalIgnoreCase))">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.History" Color="Color.Primary"/>
        <MudText Typo="Typo.h6">@Loc[LocKeys.Image.Versions]</MudText>

        <MudSpacer/>
        <MudTextField T="string" @bind-Value="_gridSearch0" DebounceInterval="300" Clearable="true" Placeholder="@Loc[LocKeys.Ui.ActionFiles.Search]" aria-label="@Loc[LocKeys.Ui.ImageVersionsTab.SearchVersions]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="device-inventory-search"/>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Common.Name]">
            <CellTemplate>
                <MudLink Disabled="@(!canEditImage || _saving || _loading)"
                         OnClick="@(() => OnEditClicked(context.Item))">@context.Item.Name</MudLink>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IsApproved" Title="@Loc[LocKeys.Ui.ImageVersionsTab.Approved]"/>
        <PropertyColumn Property="x => x.Number" Title="@Loc[LocKeys.Image.VersionNumber]"/>
        <TemplateColumn Title="@Loc[LocKeys.Image.VersionStatus]">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@Loc[LocKeys.Image.ActiveVersion]</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Image.UploadedAt]">
            <CellTemplate>@context.Item.UploadedAtUtc.ToLocalTime().ToString("g")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Image.VersionSize]">
            <CellTemplate>@UiText.Get(LocKeys.Ui.ImageVersionsTab.Text0MB, (((context.Item.SizeBytes / 1048576d).ToString("N2"))))</CellTemplate>
        </TemplateColumn>
        @if (Image.Format == ImageFormat.Ffu)
        {
            <TemplateColumn Title="@Loc[LocKeys.Ui.ImageVersionsTab.MinimumDiskSize]">
                <CellTemplate>
                    @if (context.Item.MinimumDiskSizeBytes is { } minimum)
                    {
                        <MudTooltip Text="@(minimum.ToString("N0") + " bytes")">
                            @UiText.Get(LocKeys.Ui.ImageVersionsTab.Text0GiB, (((Math.Ceiling(minimum / 1073741824m * 100) / 100).ToString("N2"))))
                        </MudTooltip>
                    }
                    else
                    {
                        <span>@Loc[LocKeys.Scheduler.StatusUnknown]</span>
                    }
                </CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn Title="@Loc[LocKeys.Image.VersionStorage]">
            <CellTemplate>@context.Item.StorageProvider?.Name</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" StickyRight="true" Sortable="false" Filterable="false">
            <CellTemplate>
                <div style="display: inline-flex; flex-wrap: nowrap; align-items: center; white-space: nowrap;">
                    <PermissionView Policy="@Constants.Permissions.ImageApprove">
                        <MudTooltip Text="@Loc[LocKeys.Ui.ImageVersionsTab.Approve]" Placement="Placement.Left"
                                    Arrow="true" Delay="200">
                            <MudIconButton Icon="@Icons.Material.Filled.DoneAll" Size="Size.Medium" Color="Color.Primary"
                                           aria-label="@Loc[LocKeys.Ui.ImageVersionsTab.Approve]"
                                           Disabled="@(_saving || _loading || context.Item.IsApproved)"
                                           OnClick="@(() => ApproveAsync(context.Item))"/>
                        </MudTooltip>
                    </PermissionView>
                    <MudTooltip Text="@($"{Loc[LocKeys.Image.SetActiveVersion]} - {context.Item.Name}")" Placement="Placement.Left"
                                Arrow="true" Delay="200">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" Color="Color.Primary"
                                       aria-label="@Loc[LocKeys.Image.SetActiveVersion]" Disabled="@(!canEditImage || (_saving || _loading))"
                                       OnClick="@Snackbar.GuardAction(() => _saving || _loading || context.Item.IsActive, UiText.Get(LocKeys.Ui.ImageVersionsTab.ThisVersionIsAlreadyActive), () => OnSetActiveClicked(context.Item))"/>
                    </MudTooltip>
                    <MudTooltip Text="@($"{Loc[LocKeys.Common.Delete]} - {context.Item.Name}")" Placement="Placement.Left"
                                Arrow="true" Delay="200">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Medium" Color="Color.Primary"
                                       aria-label="@Loc[LocKeys.Common.Delete]" Disabled="@(!canEditImage || (_saving || _loading))"
                                       OnClick="@(() => OnDeleteClicked(context.Item))"/>
                    </MudTooltip>
                    </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="ImageVersion"/></PagerContent>
    <NoRecordsContent><MudText>@Loc[LocKeys.Image.NoVersions]</MudText></NoRecordsContent>
</MudDataGrid>


</ImagingEditScope>
@code {
    private async Task ApproveAsync(ImageVersion version)
    {
        _saving = true;
        try
        {
            var result = await ImagingService.ApproveVersionAsync(Image.Id, version.Id);
            if (!result.Success) Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            await OnLoadClicked();
        }
        finally { _saving = false; }
    }
    private string? _gridSearch0;

    [Parameter, EditorRequired] public Image Image { get; set; } = null!;
    private List<ImageVersion> _versions = [];
    private bool _loading = true;
    private bool _saving;

    protected override Task OnInitializedAsync() => OnLoadClicked();

    private async Task OnLoadClicked()
    {
        _loading = true;
        var result = await ImagingService.GetVersionsAsync(Image.Id);
        if (result.Success) _versions = result.Data ?? [];
        else
        {
            _versions = [];
            Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
        }
        _loading = false;
    }

    private async Task OnSetActiveClicked(ImageVersion version)
    {
        if (_saving || version.IsActive) return;
        _saving = true;
        try
        {
            var result = await ImagingService.SetActiveAsync(Image.Id, version.Id);
            if (result.Success) Snackbar.Add(Loc[LocKeys.Image.ActiveVersionUpdated, version.Name], Severity.Success);
            else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            await OnLoadClicked();
        }
        finally { _saving = false; }
    }

    private async Task OnEditClicked(ImageVersion version)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var parameters = new DialogParameters<ImageVersionEditDialog> { { x => x.Version, version } };
            var dialog = await Dialog.ShowAsync<ImageVersionEditDialog>(parameters, Constants.UI.StandardDialogBox);
            if (await dialog.Result is { Canceled: false }) await OnLoadClicked();
        }
        finally { _saving = false; }
    }

    private async Task OnDeleteClicked(ImageVersion version)
    {
        if (_saving) return;
        var message = UiText.Get(LocKeys.Ui.ImageVersionsTab.Delete0AndItsStoredImageFilesFileCleanup, (version.Name)) +
            (version.IsActive ? UiText.Get(LocKeys.Ui.ImageVersionsTab.ThisIsTheActiveVersionNoReplacementWillBe) : "");
        if (await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.ImageVersionsTab.DeleteImageVersion), message, yesText: UiText.Get(LocKeys.Common.Delete), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true) return;
        _saving = true;
        try
        {
            var result = await ImagingService.DeleteVersionAsync(Image.Id, version.Id);
            if (result.Success) Snackbar.Add(UiText.Get(LocKeys.Ui.ImageVersionsTab.VersionDeletedStoredFilesAreQueuedForCleanup), Severity.Success);
            else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            await OnLoadClicked();
            if (result.Success && Image.LastUploadGuid == version.Id) Image.LastUploadGuid = _versions.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        finally { _saving = false; }
    }
}
