@inject ImagingService Deployments
@implements IAsyncDisposable

<MudStack Spacing="3" Class="py-4">
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    <MudTable T="MulticastRow" Items="_sessions" Dense="true" Hover="true">
        <HeaderContent><MudTh>@Loc[LocKeys.Common.Name]</MudTh><MudTh>@Loc[LocKeys.Device.Image]</MudTh><MudTh>@Loc[LocKeys.Dashboard.RequestedBy]</MudTh><MudTh>@Loc[LocKeys.Ui.MulticastSessionsTab.Sender]</MudTh><MudTh>@Loc[LocKeys.Image.VersionStatus]</MudTh><MudTh>@Loc[LocKeys.Ui.MulticastSessionsTab.DevicesPreparedExpected]</MudTh><MudTh /></HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd><MudTd>@context.Image</MudTd><MudTd>@context.RequestedBy</MudTd><MudTd>@context.Host</MudTd>
            <MudTd>@UiText.Label(context.State) @context.Error</MudTd><MudTd>@context.Joined / @context.Expected</MudTd>
            <MudTd>@if (context.CanManage && context.State < MulticastState.Completed) { <MudButton Color="Color.Error" Disabled="_busy" OnClick="@(() => Cancel(context.Id))">@Loc[LocKeys.Common.Cancel]</MudButton> }
                else if (context.CanRemoveHistory && context.State >= MulticastState.Completed) { <MudButton Disabled="_busy" OnClick="@(() => Remove(context.Id))">@Loc[LocKeys.Ui.MulticastSessionsTab.RemoveSessionHistory]</MudButton> }</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>@Loc[LocKeys.Ui.MulticastSessionsTab.NoMulticastSessions]</MudText></NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    [Parameter] public bool AllTasks { get; set; }
    private string? _error;
    private bool _busy, _disposed, _refreshing;
    private List<MulticastRow> _sessions = [];
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    protected override async Task OnInitializedAsync()
    {
        await Refresh(); if (!_disposed) _poll = Poll();
    }
    private async Task Cancel(Guid id)
    { _busy = true; try { await Deployments.CancelMulticastAsync(id); await Refresh(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } finally { _busy = false; } }
    private async Task Remove(Guid id)
    { _busy = true; try { await Deployments.RemoveMulticastHistoryAsync(id); await Refresh(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } finally { _busy = false; } }
    private async Task Refresh()
    {
        if (_disposed || _refreshing) return;
        _refreshing = true;
        try
        {
            var sessions = await Deployments.MulticastListAsync(AllTasks);
            if (_disposed) return;
            _sessions = sessions; _error = null;
        }
        catch (Exception ex) { if (!_disposed) { _sessions = []; _error = ex.Message; } }
        finally { _refreshing = false; }
    }
    private async Task Poll()
    {
        var token = _stop.Token;
        try
        {
            while (true)
            {
                await Task.Delay(5000, token);
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await Refresh();
                    if (!_disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _stop.Cancel();
        if (_poll is not null) await _poll;
        _stop.Dispose();
    }
}
