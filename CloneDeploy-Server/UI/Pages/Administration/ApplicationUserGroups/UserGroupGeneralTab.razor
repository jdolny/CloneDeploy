@inject AppUserService AppUserService
@if (_loading) { <MudProgressLinear Indeterminate="true"/> }
else if (_model is null) { <MudAlert Severity="Severity.Error">@Loc[LocKeys.Ui.UserGroupGeneralTab.UnableToLoadThisRecord]</MudAlert> }
else
{

<div class="section-action-bar"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_saving" OnClick="OnSaveClicked">@Loc[LocKeys.User.SaveGeneral]</MudButton></div>
<div>
    <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.User.General]</MudText>
    <MudForm @ref="_form" Disabled="_saving">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Name" Label="@Loc[LocKeys.Common.Name]" Variant="Variant.Outlined" Required="true" MaxLength="200" />
            </MudItem>
            <MudItem xs="12" md="6"><MudSelect T="bool" @bind-Value="_model.GrantAdministrator" Label="@Loc[LocKeys.User.Membership]" Variant="Variant.Outlined">
                <MudSelectItem T="bool" Value="false">@Loc[LocKeys.User.UserMembership]</MudSelectItem>
                <MudSelectItem T="bool" Value="true">@Loc[LocKeys.User.AdminMembership]</MudSelectItem>
            </MudSelect>
            <MudCheckBox T="bool" Value="@(_model.RequireWebMfa || _model.GrantAdministrator)" ValueChanged="@(value => _model.RequireWebMfa = value)" Disabled="_model.GrantAdministrator" Label="@Loc[LocKeys.Ui.NewUserGroupDialog.RequireWebMFA]" />
            <MudCheckBox T="bool" @bind-Value="_model.RequireImagingMfa" Label="@Loc[LocKeys.Ui.NewUserGroupDialog.RequireImagingMFA]" />
            </MudItem>
        </MudGrid>
    </MudForm>
</div>



}
@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private AppUserGroup? _model;
    private bool _loading = true;
    protected override async Task OnInitializedAsync()
    {
        var result = await AppUserService.GetGroupByIdAsync(Group.Id);
        if (result.Success && result.HasData) _model = result.Data;
        else Snackbar.Add(result.Success ? UiText.Get(LocKeys.Ui.UserGroupGeneralTab.RecordNotFound) : Loc[result.Error!.Code, result.Error.Args], Severity.Error);
        _loading = false;
    }

    [Parameter, EditorRequired] public AppUserGroup Group { get; set; } = null!;
    private MudForm _form = null!;
    private bool _saving;

    private async Task OnSaveClicked()
    {
        if (_saving || _model is null) return;
        _saving = true;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            _saving = false;
            return;
        }
        var result = await AppUserService.UpdateGroupGeneralAsync(_model!);
        if (result.Success)
        {
            await OnSaved.InvokeAsync();
            Snackbar.Add(Loc[LocKeys.Common.Updated, _model.Name], Severity.Success);
        }
        else
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _saving = false;
    }

}
