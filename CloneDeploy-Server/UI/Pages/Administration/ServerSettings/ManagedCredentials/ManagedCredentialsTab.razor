
@inject ManagedCredentialService ManagedCredentialService
@if (!Embedded) { <AppPageTitle Text="@Loc[LocKeys.Common.ManagedCredentials]" /> }

<div class="section-action-bar">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               OnClick="@OnNewClicked" StartIcon="@Icons.Material.Filled.Add">
        @Loc[LocKeys.ManagedCredential.NewManagedCredential]
    </MudButton>
</div>

<MudPaper Class="device-list-filters device-search-panel" Elevation="0" Outlined="true">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string"
                          ValueChanged="OnSearchChanged"
                          DebounceInterval="300"
                          Placeholder="@($"{Loc[LocKeys.Common.Search]}...")"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="false"
                          Class="mt-0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
        </MudItem>
    </MudGrid>
</MudPaper>

<div style="height: 6px;">
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
    }
</div>

<MudDataGrid T="ManagedCredentialDto"
             Items="@_items"
             Dense="true"
             Elevation="0"
             MultiSelection="true"
             @bind-SelectedItems="_selectedItems"
             RowsPerPage="@Constants.UI.DefaultPageSize"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterMenu"
             ColumnResizeMode="ResizeMode.Column"
             Hover="true"
             Class="device-list-grid mb-8" Outlined="true" SelectOnRowClick="false">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.Key" Color="Color.Primary"/>
        <MudText Typo="Typo.h6">@Loc[LocKeys.Common.ManagedCredentials]</MudText>
        <MudSpacer/>
        <div class="grid-toolbar-actions">
            <GridSelectionCount Count="_selectedItems.Count"/>
            @if (_selectedItems.Count > 0)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="@OnDeleteSelectedClicked"
                       StartIcon="@Icons.Material.Filled.Delete"
                      >
                @Loc[LocKeys.Common.DeleteSelected]
            </MudButton>
        }
        </div>
    </ToolBarContent>

    <Columns>
        <SelectColumn T="ManagedCredentialDto"/>
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Common.Name]"><CellTemplate><button type="button" class="resource-name-link" @onclick="@(() => OnEditClicked(context.Item))">@context.Item.Name</button></CellTemplate></PropertyColumn>
        <PropertyColumn Property="x => x.Username" Title="@Loc[LocKeys.ManagedCredential.Username]"/>
        <PropertyColumn Property="x => x.Guid" Title="@Loc[LocKeys.ManagedCredential.Guid]"/>
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" StickyRight="true" Sortable="false" Filterable="false">
            <CellTemplate>

                <MudTooltip Text="@($"{Loc[LocKeys.Common.Delete]} - {context.Item.Name}")" Placement="Placement.Left"
                            Arrow="true" Delay="200">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Medium"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnDeleteClicked(context.Item))"/>
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="ManagedCredentialDto"/>
    </PagerContent>

    <NoRecordsContent>
        <MudText>@Loc[LocKeys.ManagedCredential.NoManagedCredentialsFound]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    [Parameter] public bool Embedded { get; set; }
    private List<ManagedCredentialDto> _items = [];
    private HashSet<ManagedCredentialDto> _selectedItems = [];
    private bool _isLoading = true;
    private string? _search;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await ManagedCredentialService.GetAsync(_search);
        _items = result.Data ?? [];
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _selectedItems.Clear();

        _isLoading = false;
        StateHasChanged();
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        await LoadAsync();
    }

    private async Task OnNewClicked()
    {
        var dialog = await Dialog.ShowAsync<ManagedCredentialDialog>(Constants.UI.StandardDialogBox);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OnEditClicked(ManagedCredentialDto item)
    {
        var parameters = new DialogParameters<ManagedCredentialDialog>
        {
            { x => x.ManagedCredential, item }
        };

        var dialog = await Dialog.ShowAsync<ManagedCredentialDialog>(parameters, Constants.UI.StandardDialogBox);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OnDeleteClicked(ManagedCredentialDto item)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, Loc[LocKeys.ManagedCredential.ConfirmDelete, item.Name] },
            { x => x.ButtonText, Loc[LocKeys.Common.Delete] },
            { x => x.Color, Color.Error }
        };
        var dialog = await Dialog.ShowAsync<ConfirmationDialog>(parameters, Constants.UI.StandardDialogBox);
        var dialogResult = await dialog.Result;

        if (dialogResult is { Canceled: false, Data: true })
        {
            var result = await ManagedCredentialService.DeleteAsync(item.Id);

            if (result.Success)
            {
                Snackbar.Add(Loc[LocKeys.Common.Deleted, item.Name], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            }
        }
    }

    private async Task OnDeleteSelectedClicked()
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, Loc[LocKeys.ManagedCredential.ConfirmDeleteMany] },
            { x => x.ButtonText, Loc[LocKeys.Common.Delete] },
            { x => x.Color, Color.Error }
        };
        var dialog = await Dialog.ShowAsync<ConfirmationDialog>(parameters, Constants.UI.StandardDialogBox);
        var dialogResult = await dialog.Result;

        if (dialogResult is { Canceled: false, Data: true })
        {
            var result = await ManagedCredentialService.DeleteManyAsync(_selectedItems.Select(x => x.Id).ToList());

            if (result.Success)
            {
                Snackbar.Add(Loc[LocKeys.Common.DeletedMany], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            }
        }
    }
}
