@inject ManagedCredentialService ManagedCredentialService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_isNew ? Loc[LocKeys.ManagedCredential.NewManagedCredential] : Loc[LocKeys.ManagedCredential.EditManagedCredential])
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_managedCredential.Name" Label="@Loc[LocKeys.Common.Name]" Variant="Variant.Outlined"
                          Required="true"/>
            <MudTextField @bind-Value="_managedCredential.Username" Label="@Loc[LocKeys.ManagedCredential.Username]"
                          Variant="Variant.Outlined"
                          Required="true"/>
            <MudTextField @bind-Value="_password" Label="@Loc[LocKeys.ManagedCredential.Password]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="@_isNew"/>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@OnCancelClicked">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@OnSaveClicked">
            @(_isNew ? Loc[LocKeys.Common.Create] : Loc[LocKeys.Common.Save])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ManagedCredentialDto? ManagedCredential { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private ManagedCredentialDto _managedCredential = null!;
    private bool _isNew => ManagedCredential is null || ManagedCredential.Id == 0;
    private MudForm _form = null!;
    private string? _password;

    protected override void OnInitialized()
    {
        _managedCredential = ManagedCredential is null
            ? new ManagedCredentialDto()
            : new ManagedCredentialDto
            {
                Id = ManagedCredential.Id,
                Name = ManagedCredential.Name,
                Username = ManagedCredential.Username,
                Guid = ManagedCredential.Guid
            };
    }

    private void OnCancelClicked()
    {
        MudDialog.Cancel();
    }

    private async Task OnSaveClicked()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        ServiceResult<ManagedCredentialDto> result;

        if (_isNew)
            result = await ManagedCredentialService.CreateAsync(_managedCredential, _password!);
        else
            result = await ManagedCredentialService.UpdateAsync(_managedCredential, _password);

        if (result.Success)
        {
            Snackbar.Add(_isNew ? Loc[LocKeys.Common.Created, _managedCredential.Name] : Loc[LocKeys.Common.Updated, _managedCredential.Name], Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Data));
        }
        else
            Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
    }
}
