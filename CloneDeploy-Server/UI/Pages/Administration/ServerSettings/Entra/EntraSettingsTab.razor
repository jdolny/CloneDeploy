@attribute [Authorize(Policy = Constants.Permissions.AdminOnly)]
@inject DirectoryService Entra
@inject DirectoryService Directories


@if (Source is null)
{
    <div class="section-action-bar">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
        <MudButton OnClick="@Snackbar.GuardAction(() => _busy || _settings is null, UiText.Get(LocKeys.Ui.EntraSettingsTab.EntraSettingsCouldNotBeLoadedRefreshThePage), Save)" Disabled="@(_busy)" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton>
        @if (_settings is not null && _settings.PendingCertificatePem is null)
        {
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;" Disabled="_busy" aria-label="@Loc[LocKeys.Ui.ActionButtons.MoreActions]">
                <MudMenuItem OnClick="Generate" Disabled="_busy">@Loc[LocKeys.Ui.EntraSettingsTab.GenerateCertificate]</MudMenuItem>
            </MudMenu>
        }
        </MudButtonGroup>
    </div>
}
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
@if (_settings is not null)
{
    @if (Source is null)
    {
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.EntraSettingsTab.ApplicationConnection]</MudText>
        <MudTextField @bind-Value="_settings.TenantId" Label="@Loc[LocKeys.Ui.EntraSettingsTab.DirectoryTenantID]" Variant="Variant.Outlined" Disabled="_busy" />
        <MudTextField @bind-Value="_settings.ClientId" Label="@Loc[LocKeys.Ui.EntraSettingsTab.ApplicationClientID]" Variant="Variant.Outlined" Disabled="_busy" />
        @if (_settings.RedirectUri is null) { <MudAlert Severity="Severity.Warning">@Loc[LocKeys.Ui.EntraSettingsTab.ConfigureThePublicApplicationURLInServerSettingsBefore]</MudAlert> }
        <MudSwitch Color="Color.Primary" @bind-Value="_settings.SsoEnabled" Label="@Loc[LocKeys.Ui.EntraSettingsTab.EnableMicrosoftSignIn]" Disabled="_busy" />
    </MudPaper>
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.EntraSettingsTab.ApplicationCertificate]</MudText>
        <MudText>@UiText.Get(LocKeys.Ui.EntraSettingsTab.ActiveCertificateExpires0, ((_settings.CertificateExpiresUtc?.ToLocalTime().ToString("g") ?? UiText.Get(LocKeys.Ui.EntraSettingsTab.NoActiveCertificate))))</MudText>
        @if (_settings.CertificateExpiresUtc is { } expiry && expiry < DateTime.UtcNow.AddDays(30))
        { <MudAlert Severity="Severity.Warning">@Loc[LocKeys.Ui.EntraSettingsTab.TheActiveCertificateExpiresSoonOrHasExpiredGenerate]</MudAlert> }
        @if (_settings.CertificatePem is { } active)
        { <MudButton Href="@Download(active)" download="clonedeploy-entra.cer">@Loc[LocKeys.Ui.EntraSettingsTab.DownloadActivePublicCertificate]</MudButton> }
        @if (_settings.PendingCertificatePem is { } pending)
        {
            <MudText>@UiText.Get(LocKeys.Ui.EntraSettingsTab.PendingCertificateExpires0, (_settings.PendingCertificateExpiresUtc?.ToLocalTime().ToString("g")))</MudText>
            <MudButton Href="@Download(pending)" download="clonedeploy-entra-pending.cer">@Loc[LocKeys.Ui.EntraSettingsTab.DownloadPendingPublicCertificate]</MudButton>
            <MudText Class="my-2">@Loc[LocKeys.Ui.EntraSettingsTab.UploadThisCertificateToYourAppRegistrationBeforeActivating]</MudText>
            <MudText Typo="Typo.caption">@Loc[LocKeys.Ui.EntraSettingsTab.ForSSOOnlyInstallationsLeaveTheDirectoryPermissionCheck]</MudText>
            <MudSwitch Color="Color.Primary" @bind-Value="_testGraph" Label="@Loc[LocKeys.Ui.EntraSettingsTab.AlsoVerifyDirectoryReadPermissionsDuringActivation]" Disabled="_busy" />
            <MudButton OnClick="Activate" Disabled="_busy" Color="Color.Primary">@(_testGraph ? UiText.Get(LocKeys.Ui.EntraSettingsTab.TestAndActivate) : UiText.Get(LocKeys.Ui.EntraSettingsTab.ActivateForSSO))</MudButton>
            <MudButton OnClick="Discard" Disabled="_busy">@Loc[LocKeys.Ui.EntraSettingsTab.DiscardPendingCertificate]</MudButton>
        }
    </MudPaper>
    }
    @if (Source is not null)
    {
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudTextField @bind-Value="_directoryName" Label="@Loc[LocKeys.Ui.DirectoryConnectionDialog.ConnectionName]" Variant="Variant.Outlined" MaxLength="200" Disabled="_busy" />
        <MudTextField @bind-Value="_description" Label="@Loc[LocKeys.Common.Description]" Lines="3" MaxLength="2000" Variant="Variant.Outlined" Disabled="_busy" />
        <MudSwitch Color="Color.Primary" @bind-Value="_accessOnly" Label="@Loc[LocKeys.Ui.DirectoryConnectionDialog.ApplicationAccessOnly]" Disabled="_busy" />
        <MudSwitch Color="Color.Primary" @bind-Value="_syncEnabled" Label="@Loc[LocKeys.Ui.EntraSettingsTab.EnableDirectorySync]" Disabled="_busy" />
        @if (SaveActionSectionId is not null)
        {
            <SectionContent SectionId="SaveActionSectionId">@SaveDirectoryButton</SectionContent>
        }
        else
        {
            @SaveDirectoryButton
        }
        <MudText Typo="Typo.caption">@Loc[LocKeys.Ui.EntraSettingsTab.SaveTheApplicationIDsAndActivateACertificateBefore]</MudText>
    </MudPaper>
    }
}


@code {
    [Parameter] public object? SaveActionSectionId { get; set; }
    private RenderFragment SaveDirectoryButton => @<MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
        <MudButton OnClick="SaveDirectory" Disabled="_busy" StartIcon="@Icons.Material.Filled.Save">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton>
        <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;" Disabled="_busy" aria-label="@Loc[LocKeys.Ui.ActionButtons.MoreActions]">
            <MudMenuItem OnClick="Test" Disabled="_busy">@Loc[LocKeys.Ui.EntraSettingsTab.TestDirectoryAccess]</MudMenuItem>
        </MudMenu>
    </MudButtonGroup>;
    private EntraSettingsDto? _settings;
    private bool _busy;
    private bool _testGraph = true;
    private string? _error;
    [Parameter] public DirectorySource? Source { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    private string _description = "";
    private int _sourceId;
    private string _directoryName = UiText.Get(LocKeys.Ui.DirectorySettingsTab.MicrosoftEntraID);
    private bool _syncEnabled = true;
    private bool _accessOnly;
    protected override Task OnInitializedAsync() { _testGraph = Source is not null; return Load(); }
    private async Task Load()
    {
        var result = await Entra.GetEntraAsync();
        if (result.Success) _settings = result.Data; else _error = Loc[result.Error!.Code, result.Error.Args];
        if (Source is null) return;
        var sources = await Directories.GetSourcesAsync();
        if (!sources.Success) { _error = Loc[sources.Error!.Code, sources.Error.Args]; _settings = null; return; }
        if (sources.Data!.SingleOrDefault(x => x.Id == Source.Id) is { } source)
        {
            _sourceId = source.Id;
            _directoryName = source.Name;
            _description = source.Description;
            _syncEnabled = source.IsEnabled;
            _accessOnly = source.ApplicationAccessOnly;
        }
    }
    private async Task Run(Func<Task<CloneDeploy_Server.Backend.Common.ServiceResult<bool>>> operation)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var result = await operation();
            if (!result.Success) Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            else { Snackbar.Add(UiText.Get(LocKeys.Ui.EntraSettingsTab.OperationCompleted), Severity.Success); await Load(); }
        }
        finally { _busy = false; }
    }
    private Task Save() => Run(() => Entra.SaveEntraAsync(_settings!));
    private Task Generate() => Run(Entra.EntraGenerateAsync);
    private Task Activate() => Run(() => Entra.EntraActivateAsync(_testGraph));
    private Task Discard() => Run(Entra.EntraDiscardPendingAsync);
    private Task Test() => Run(Entra.TestEntraAsync);
    private async Task SaveDirectory()
    {
        if (_busy || Source is null) return;
        _busy = true; _error = null;
        try
        {
            var result = await Directories.SaveEntraSourceAsync(new DirectorySource
            {
                Id = _sourceId, Name = _directoryName, Description = _description, Provider = DirectoryProvider.EntraId, IsEnabled = _syncEnabled, ApplicationAccessOnly = _accessOnly
            });
            if (!result.Success) Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
            else { Snackbar.Add(UiText.Get(LocKeys.Ui.EntraSettingsTab.DirectoryConnectionSaved), Severity.Success); await Load(); await OnSaved.InvokeAsync(); }
        }
        finally { _busy = false; }
    }
    private static string Download(string pem) => "data:application/x-pem-file;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(pem));
}
