@attribute [Authorize(Policy = Constants.Permissions.AdminOnly)]
@inject ServerSettingsUiService Settings
@inject ServerFeatureSettings Features

@if (!Embedded) { <AppPageTitle Text="@Loc[LocKeys.Ui.PublicServerUrl.ServerSettings]" /> }
<div class="section-action-bar">
    <MudButton OnClick="@Snackbar.GuardAction(() => _busy || _loading || !_loaded, UiText.Get(LocKeys.Ui.UserGroupDirectoryTab.SettingsCouldNotBeLoadedRefreshAndTryAgain), OnSaveClicked)" Disabled="@(_busy || _loading)" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton>
</div>
@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="my-3">@_error</MudAlert> }
<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.ServerSettingsTab.ApplicationURL]</MudText>
    <MudTextField @bind-Value="_url" Label="@Loc[LocKeys.Ui.ServerSettingsTab.PublicApplicationURL]" Variant="Variant.Outlined" Immediate="true" Disabled="@(_busy || _loading)" MaxLength="2048"
                  Placeholder="@ApplicationUrlPlaceholder" HelperText="@(_loaded && string.IsNullOrWhiteSpace(_original) ? UiText.Get(LocKeys.Ui.ServerSettingsTab.NoApplicationURLHasBeenSavedEnterThePublic) : null)" />
</MudPaper>
<MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.ServerSettingsTab.SiteServiceConnections]</MudText>
    <MudTextField @bind-Value="_mainServerAddress" Label="@Loc[LocKeys.Ui.SiteServiceGeneralTab.MainServerIP]" Variant="Variant.Outlined" Immediate="true" Disabled="@(_busy || _loading)" MaxLength="45" />
</MudPaper>
<MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.ServerSettingsTab.IPXEBootURL]</MudText>
    <MudTextField T="string" Value="@BootUrlPreview" Label="@Loc[LocKeys.Ui.ServerSettingsTab.EffectivePXEBootURL]" Variant="Variant.Outlined" ReadOnly="true" />
    <MudTextField @bind-Value="_bootUrl" Label="@Loc[LocKeys.Ui.ServerSettingsTab.PXEBootURLOverride]" Variant="Variant.Outlined" Class="mt-4" MaxLength="2048" Immediate="true" Disabled="@(_busy || _loading)" Placeholder="@Loc[LocKeys.Ui.ServerSettingsTab.HttpServer5077]" />
</MudPaper>

<MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.ServerSettingsTab.EnabledServerFeatures]</MudText>
    <MudSwitch T="bool" @bind-Value="_management" Color="Color.Primary" Disabled="@(!_loaded || _busy || _loading)">@Loc[LocKeys.Ui.ServerSettingsTab.Management]</MudSwitch>
    <MudSwitch T="bool" @bind-Value="_imaging" Color="Color.Primary" Disabled="@(!_loaded || _busy || _loading)">@Loc[LocKeys.Device.Imaging]</MudSwitch>
</MudPaper>

@code {
    [Parameter] public bool Embedded { get; set; }
    private string _url = "";
    private string ApplicationUrlPlaceholder => Navigation.BaseUri.StartsWith("http:", StringComparison.OrdinalIgnoreCase)
        ? "https:" + Navigation.BaseUri[5..] : Navigation.BaseUri;
    private string? _original, _bootUrl, _originalBootUrl, _error;
    private string? _mainServerAddress, _originalMainServerAddress;
    private bool _loading = true, _busy, _loaded;
    private bool _management = true, _imaging = true;
    private ServerFeatures _originalFeatures = new();
    private string? BootUrlPreview
    {
        get
        {
            try { return ServerSettingsUiService.NormalizeBootUrl(_bootUrl) ?? ServerSettingsUiService.DeriveBootUrl(_url); }
            catch (InvalidDataException) { return null; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Settings.ReadAsync();
            var boot = await Settings.ReadBootOverrideAsync();
            var address = await Settings.ReadMainServerAddressAsync();
            var features = await Settings.ReadServerFeaturesAsync();
            if (!result.Success) { _error = Loc[result.Error.Code, result.Error.Args]; return; }
            if (!boot.Success) { _error = Loc[boot.Error.Code, boot.Error.Args]; return; }
            if (!address.Success) { _error = Loc[address.Error.Code, address.Error.Args]; return; }
            if (!features.Success) { _error = Loc[features.Error.Code, features.Error.Args]; return; }
            _originalFeatures = features.Data!;
            _management = _originalFeatures.Management;
            _imaging = _originalFeatures.Imaging;
            _original = result.Data;
            _url = result.Data ?? string.Empty;
            _bootUrl = _originalBootUrl = boot.Data;
            _mainServerAddress = _originalMainServerAddress = address.Data;
            _loaded = true;
        }
        finally { _loading = false; }
    }

    private async Task OnSaveClicked()
    {
        if (_busy || !_loaded) return;
        _busy = true;
        _error = null;
        try
        {
            var features = new ServerFeatures(_management, _imaging);
            var result = await Settings.SaveGeneralAsync(_url, _bootUrl, _original, _originalBootUrl, _mainServerAddress, _originalMainServerAddress, features, _originalFeatures);
            if (result.Success)
            {
                _url = _original = result.Data!;
                _bootUrl = _originalBootUrl = ServerSettingsUiService.NormalizeBootUrl(_bootUrl);
                _mainServerAddress = _originalMainServerAddress = ServerUrlSettingsStore.NormalizeMainServerAddress(_mainServerAddress);
                _originalFeatures = features;
                Features.NotifyChanged();
                Snackbar.Add(UiText.Get(LocKeys.Ui.ServerSettingsTab.ServerSettingsSaved), Severity.Success);
            }
            else Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        }
        finally { _busy = false; }
    }
}
