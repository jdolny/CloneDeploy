@inject HelpDeskUiService Settings
@inject AuthenticationStateProvider Authentication

<MudDialog>
    <DialogContent>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }
        <MudForm @ref="_form" Disabled="_busy">
            <MudTextField T="string" @bind-Value="_name" Label="@Loc[LocKeys.Common.Name]" Disabled="@(QueueId == HelpQueue.UnassignedId)" Required="true" MaxLength="100" Variant="Variant.Outlined" />
            <MudSwitch T="bool" @bind-Value="_emailEnabled" Label="@Loc[LocKeys.Ui.HelpConfigurationNamesTab.EmailStaffAboutTicketActivity]" Color="Color.Primary" Disabled="@(_busy || !_loaded)" />
            @if (!_loaded)
            {
                @if (_error is null) { <MudProgressLinear Indeterminate="true" /> }
            }
            else
            {
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_members" Label="@(QueueId == HelpQueue.UnassignedId ? Loc["HelpDesk.NotifyApplicationUsers"] : Loc[LocKeys.Ui.HelpConfigurationNamesTab.QueueMembers])" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_busy || !_loaded)" ToStringFunc="MemberName">
                    @foreach (var missing in _members.Where(id => _staff.All(x => x.Id != id)).ToArray())
                    { <MudSelectItem T="int" Value="missing">@UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.Text0RemoveToSave, (MemberName(missing)))</MudSelectItem> }
                    @foreach (var staff in _staff) { <MudSelectItem T="int" Value="staff.Id">@staff.Name</MudSelectItem> }
                </MudSelect>
            }
            @if (QueueId == HelpQueue.UnassignedId)
            {
                <MudText Typo="Typo.caption">@Loc["HelpDesk.UnassignedRecipientsHint"]</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption">@Loc[LocKeys.Ui.HelpConfigurationNamesTab.OnlyActiveStaffWithManagementAndAssignedTicketVisibility]</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton OnClick="Create" Disabled="@(_busy || !_loaded)" Color="Color.Primary" Variant="Variant.Filled">@(QueueId == 0 ? Loc[LocKeys.Common.Create] : Loc[LocKeys.Common.SaveChanges])</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int QueueId { get; set; }
    [Parameter] public string QueueName { get; set; } = "";
    [Parameter] public bool EmailEnabled { get; set; }
    [Parameter] public int[] MemberIds { get; set; } = [];
    private bool _emailEnabled, _loaded;
    private HelpStaff[] _staff = [];
    private IReadOnlyCollection<int> _members = [];
    private string MemberName(int id) => _staff.FirstOrDefault(x => x.Id == id)?.Name ?? UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.UnavailableStaff0, id);
    protected override async Task OnInitializedAsync()
    {
        _name = QueueName; _emailEnabled = EmailEnabled;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            _staff = (await Settings.StaffAsync(user)).Where(x => x.ManageAll || (QueueId == HelpQueue.UnassignedId ? x.ManageUnassigned : x.ManageAssigned)).ToArray();
            _members = MemberIds.ToArray();
            _loaded = true;
        }
        catch { _error = UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.HelpDeskConfigurationCouldNotBeSavedOrLoaded); }
    }
    private MudForm _form = null!;
    private string _name = "";
    private string? _error;
    private bool _busy;
    private void Cancel() => MudDialog.Cancel();
    private async Task Create()
    {
        if (_busy || !_loaded) return;
        _busy = true; _error = null;
        try
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            await Settings.SaveRoutingQueueAsync(user, QueueId, _name, _members.ToArray(), _emailEnabled);
            Snackbar.Add(UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.HelpDeskConfigurationSaved), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch { _error = UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.HelpDeskConfigurationCouldNotBeSavedOrLoaded); }
        finally { _busy = false; }
    }
}
