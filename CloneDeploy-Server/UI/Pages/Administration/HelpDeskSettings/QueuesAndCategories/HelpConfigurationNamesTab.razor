@inject HelpDeskUiService Settings
@inject HelpDeskUiService Help
@inject AuthenticationStateProvider Authentication

<div class="section-action-bar"><MudButton OnClick="OnCreateClicked" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">@UiText.Get(LocKeys.Ui.DeviceReportColumnsDialog.Add0, ((IsQueue ? "queue" : "category")))</MudButton></div>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }
<MudDataGrid T="Entry" Items="Entries" Loading="_busy" Dense="true" Hover="true" Elevation="0" Class="device-list-grid">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Common.Name]">
            <CellTemplate>
                @if (IsQueue) { <MudLink OnClick="@(() => OpenQueueDialog(context.Item.Id))" Disabled="_busy">@context.Item.Name</MudLink> }
                else { <MudLink OnClick="@(() => EditCategory(context.Item))" Disabled="_busy">@context.Item.Name</MudLink> }
            </CellTemplate>
        </PropertyColumn>
        @if (IsQueue) { <PropertyColumn Property="x => x.Members" Title="@Loc[LocKeys.Ui.HelpConfigurationNamesTab.Members]" /><TemplateColumn Title="@Loc[LocKeys.User.Email]"><CellTemplate>@(_settings.Queues.Single(x => x.Id == context.Item.Id).EmailEnabled ? UiText.Get(LocKeys.StorageProvider.Enabled) : UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.Off))</CellTemplate></TemplateColumn> }
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" Sortable="false"><CellTemplate>
            <MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Common.Delete]">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" OnClick="@(() => Delete(context.Item))" Disabled="@(_busy || IsQueue && context.Item.Id == HelpQueue.UnassignedId)" aria-label="@UiText.Get(LocKeys.Ui.ActionFiles.Delete0_7eab122c, context.Item.Name)" />
            </MudTooltip>
        </CellTemplate></TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">@UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.No0Configured, ((IsQueue ? "queues" : "categories")))</MudText></NoRecordsContent>
</MudDataGrid>
@code {
    [Parameter] public bool IsQueue { get; set; }
    private HelpRoutingSettings _settings = new([], [], []);
    private HelpStaff[] _staff = [];
    private string? _error;
    private bool _busy;
    private sealed record Entry(int Id, string Name, string Members);
    private IEnumerable<Entry> Entries => IsQueue
        ? _settings.Queues.Select(x => new Entry(x.Id, x.Name, string.Join(", ", x.Members.Select(m => MemberName(m.UserId)))))
        : _settings.Categories.Select(x => new Entry(x.Id, x.Name, ""));
    private string MemberName(int id) => _staff.FirstOrDefault(x => x.Id == id)?.Name ?? UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.UnavailableStaff0, (id));
    protected override async Task OnInitializedAsync() => await Run(Load);
    private async Task Load()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _settings = await Settings.ReadRoutingAsync(user);
        _staff = await Help.StaffAsync(user);
    }
    private async Task OnCreateClicked()
    {
        if (_busy) return;
        if (IsQueue) { await OpenQueueDialog(0); return; }
        var dialog = await Dialog.ShowAsync<HelpCategoryCreateDialog>(UiText.Get(LocKeys.Ui.DeviceReportColumnsDialog.Add0, "category"),
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false })
        {
            await Run(Load);
        }
    }
    private async Task EditCategory(Entry entry)
    {
        if (_busy) return;
        var parameters = new DialogParameters<HelpCategoryCreateDialog>
        {
            { x => x.CategoryId, entry.Id },
            { x => x.CategoryName, entry.Name }
        };
        var dialog = await Dialog.ShowAsync<HelpCategoryCreateDialog>(UiText.Get(LocKeys.Common.Edit), parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false }) await Run(Load);
    }
    private async Task OpenQueueDialog(int id)
    {
        if (_busy) return;
        var queue = _settings.Queues.FirstOrDefault(x => x.Id == id);
        var parameters = new DialogParameters<HelpQueueDialog>
        {
            { x => x.QueueId, id },
            { x => x.QueueName, queue?.Name ?? "" },
            { x => x.EmailEnabled, queue?.EmailEnabled ?? false },
            { x => x.MemberIds, queue?.Members.Select(x => x.UserId).ToArray() ?? [] }
        };
        var dialog = await Dialog.ShowAsync<HelpQueueDialog>(id == 0 ? UiText.Get(LocKeys.Ui.DeviceReportColumnsDialog.Add0, "queue") : UiText.Get(LocKeys.Common.Edit), parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false }) await Run(Load);
    }
    private async Task Delete(Entry entry)
    {
        if (await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.DeleteConfiguration), UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.Delete0ItemsUsedByTicketsOrRulesCannot, (entry.Name)), yesText: UiText.Get(LocKeys.Common.Delete), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true) return;
        await Run(async () => { await Settings.DeleteRoutingAsync((await Authentication.GetAuthenticationStateAsync()).User, IsQueue ? "queue" : "category", entry.Id); await Load(); });
    }
    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await action(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch { _error = UiText.Get(LocKeys.Ui.HelpConfigurationNamesTab.HelpDeskConfigurationCouldNotBeSavedOrLoaded); }
        finally { _busy = false; }
    }
}
