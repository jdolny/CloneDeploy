@inject HelpDeskUiService Settings
@inject AuthenticationStateProvider Authentication

@if (ActionSectionId is not null)
{
    <SectionContent SectionId="ActionSectionId">@Actions</SectionContent>
}
else
{
    <div class="section-action-bar">@Actions</div>
}

@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }
<MudDataGrid T="HelpRoutingRule" Items="_settings.Rules.Where(x => x.Stage == Stage)" Loading="_busy" Dense="true" Hover="true" Elevation="0" Class="device-list-grid" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="x => x.Order" Title="@Loc[LocKeys.Ui.DeploymentPoliciesTab.Order]" />
        <PropertyColumn Property="x => x.Id" Title="@Loc[LocKeys.Ui.DeployActionPage.ID]" />
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Ui.ManageOuNamingRulePage.Rule]">
            <CellTemplate><MudLink OnClick="@(() => OpenRule(context.Item))" Disabled="_busy">@context.Item.Name</MudLink></CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="@Loc[LocKeys.StorageProvider.Enabled]"><CellTemplate>@(context.Item.Enabled ? UiText.Get(LocKeys.User.Yes) : UiText.Get(LocKeys.User.No))</CellTemplate></TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Ui.HelpRoutingRulesTab.Conditions]"><CellTemplate>@ConditionSummary(context.Item)</CellTemplate></TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Dashboard.Action]"><CellTemplate>@Target(context.Item)</CellTemplate></TemplateColumn>
        <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Placement="Placement.Left" Text="@Loc[LocKeys.Common.Delete]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" OnClick="@(() => Delete(context.Item))" Disabled="_busy" aria-label="@UiText.Get(LocKeys.Ui.ActionFiles.Delete0_7eab122c, context.Item.Name)" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">@Loc[LocKeys.Ui.HelpRoutingRulesTab.NoRoutingRulesConfigured]</MudText></NoRecordsContent>
</MudDataGrid>
@code {
    [Parameter] public object? ActionSectionId { get; set; }
    private RenderFragment Actions => @<text><MudButton OnClick="@(() => OpenRule(null))" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">@Loc[LocKeys.Ui.ManageOuNamingRulePage.AddRule]</MudButton></text>;

    [Parameter] public HelpRuleStage Stage { get; set; }
    private HelpRoutingSettings _settings = new([], [], []);
    private string? _error;
    private bool _busy;
    protected override Task OnInitializedAsync() => Run(Load);
    private readonly Dictionary<string, string> _directoryLabels = [];
    private async Task Load()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _settings = await Settings.ReadRoutingAsync(user);
        _directoryLabels.Clear();
        foreach (var key in _settings.Rules.SelectMany(HelpDeskUiService.RoutingConditions).Where(c => HelpDeskUiService.IsDirectoryCondition(c.Field)).Select(c => c.Value).Distinct())
            _directoryLabels[key] = (await Settings.RoutingDirectoryChoiceAsync(user, key))?.Label ?? UiText.Get(LocKeys.Ui.HelpDirectoryPicker.UnavailableDirectoryObject);
    }
    private async Task OpenRule(HelpRoutingRule? rule)
    {
        if (_busy) return;
        var parameters = new DialogParameters<HelpRoutingRuleDialog>
        {
            { x => x.Stage, Stage },
            { x => x.Rule, rule }
        };
        var dialog = await Dialog.ShowAsync<HelpRoutingRuleDialog>(UiText.Get(rule is null ? LocKeys.Ui.HelpRoutingRulesTab.NewRule : LocKeys.Ui.RemoteAccessSettingsTab.EditRule), parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, BackdropClick = false });
        if (await dialog.Result is { Canceled: false }) await Run(Load);
    }
    private static string FieldLabel(HelpRuleField field) => field switch
    { HelpRuleField.UserDirectoryGroup => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.UserDirectoryGroup), HelpRuleField.UserDirectoryOu => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.UserDirectoryOU),
        HelpRuleField.DeviceDirectoryGroup => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.DeviceDirectoryGroup), HelpRuleField.DeviceDirectoryOu => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.DeviceDirectoryOU), HelpRuleField.TitleOrDescription => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.TitleOrDescription), HelpRuleField.DeviceName => UiText.Get(LocKeys.Ui.HelpRoutingPreviewTab.DeviceName), HelpRuleField.DeviceIp => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.DeviceInventoryIP), _ => UiText.Label(field) };
    private static string OperatorLabel(HelpRuleOperator op) => op switch { HelpRuleOperator.Regex => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.MatchesRegex), HelpRuleOperator.StartsWith => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.StartsWith), HelpRuleOperator.InRange => UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.InSubnetRange), _ => UiText.Label(op) };
    private string Target(HelpRoutingRule rule) => rule.Stage == HelpRuleStage.Categorization
        ? _settings.Categories.FirstOrDefault(x => x.Id == rule.CategoryId)?.Name ?? UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.UnavailableCategory)
        : _settings.Queues.FirstOrDefault(x => x.Id == rule.QueueId)?.Name ?? UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.UnavailableQueue);
    private string ConditionSummary(HelpRoutingRule rule)
    {
        var conditions = HelpDeskUiService.RoutingConditions(rule);
        return conditions.Length == 0 ? UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.CatchAll) : string.Join(rule.MatchAll ? " AND " : " OR ", conditions.Select(c =>
            $"{FieldLabel(c.Field)} {OperatorLabel(c.Operator).ToLowerInvariant()} {(c.Field == HelpRuleField.Category ? _settings.Categories.FirstOrDefault(x => x.Id.ToString() == c.Value)?.Name : HelpDeskUiService.IsDirectoryCondition(c.Field) ? _directoryLabels.GetValueOrDefault(c.Value, UiText.Get(LocKeys.Ui.HelpDirectoryPicker.UnavailableDirectoryObject)) : c.Value)}"));
    }
    private async Task Delete(HelpRoutingRule rule)
    {
        if (await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.WindowsUpdateAutoApprovalRulesTab.DeleteRule), UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.Delete0ExistingTicketsWillKeepTheirCategoryAnd, (rule.Name)), yesText: UiText.Get(LocKeys.Common.Delete), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true) return;
        await Run(async () => { await Settings.DeleteRoutingAsync((await Authentication.GetAuthenticationStateAsync()).User, "rule", rule.Id); await Load(); });
    }
    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await action(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch { _error = UiText.Get(LocKeys.Ui.HelpRoutingRulesTab.RoutingRulesCouldNotBeSavedOrLoadedReload); }
        finally { _busy = false; }
    }
}
