@inject WinPeService Service
@implements IAsyncDisposable

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
@if (_catalog is null)
{
    <MudProgressLinear Indeterminate="true"/>
}
else if (Section == 0)
{
    <div hidden="@_editingId.HasValue">
        <WinPeDefinitionsGrid Catalog="_catalog" IsBase="false" Changed="Refresh"
                              Edit="@(id => _editingId = id)" Create="OnCreateClicked"/>
    </div>
    @if (_editingId is { } id)
    {
        <ManageWinPe @key="id" Id="id" Kind="variant" Changed="Refresh" Closed="@(() => _editingId = null)"/>
    }
}
else if (Section == 3)
{
    <WinPeBuilderSetup Builder="_catalog.Builder"/>
}

@code {
    [Parameter] public int Section { get; set; }
    [Parameter] public int? EditId { get; set; }
    private int? _editingId;
    private bool _parametersLoaded;
    private int? _loadedEditId;
    protected override void OnParametersSet()
    {
        if (_parametersLoaded && _loadedEditId == EditId) return;
        _parametersLoaded = true;
        _loadedEditId = EditId;
        _editingId = EditId;
    }
    private WinPeCatalogDto? _catalog;
    private string? _error;

    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _poll = Poll();
    }

    private async Task OnCreateClicked()
    {
        var dialog = await Dialog.ShowAsync<WinPeCreateDialog>(UiText.Get(LocKeys.Ui.ManageWinPe.CreateBootEnvironment),
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false, Data: int id } && id > 0)
        {
            await Refresh();
            _editingId = id;
        }
    }

    private async Task Refresh()
    {
        var result = await Service.GetAsync();
        if (result.Success)
        {
            _catalog = result.Data;
            _error = null;
        }
        else _error = Loc[result.Error!.Code, result.Error.Args];
    }


    private async Task Poll()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () =>
                {
                    await Refresh();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_poll is not null) await _poll;
        _stop.Dispose();
    }

}
