@implements IAsyncDisposable
@inject PxeService Pxe
@inject TftpService TftpServer
@inject AuthenticationStateProvider Authentication
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject IJSRuntime JS

@if (_authorized)
{
    <SectionContent SectionId="ActionSectionId">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
            <MudButton OnClick="@(() => _paused = !_paused)" StartIcon="@(_paused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)">@(_paused ? UiText.Get(LocKeys.Device.Resume) : UiText.Get(LocKeys.Device.Pause))</MudButton>
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                <MudMenuItem OnClick="Clear">@Loc[LocKeys.Ui.SoftwareReportUninstallDialog.Clear]</MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
    </SectionContent>
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
        <MudSwitch @bind-Value="_follow" Color="Color.Primary" Label="@Loc[LocKeys.Ui.BootLiveActivityTab.AutoScroll]" />
        <MudText Typo="Typo.caption">@UiText.Get(LocKeys.Ui.BootLiveActivityTab.Text0Latest500EventsUTCClearAffectsOnlyThis, ((_paused ? UiText.Get(LocKeys.Ui.BootLiveActivityTab.Paused) : UiText.Get(LocKeys.Ui.BootLiveActivityTab.UpdatesEverySecond))))</MudText>
    </MudStack>
    <MudText Class="mb-3">@_status</MudText>
    @if (Tftp && _transfers.Count > 0)
    {
        <MudTable Items="_transfers" Dense="true" Hover="true" Elevation="0" Class="mb-4">
            <HeaderContent><MudTh>@Loc[LocKeys.Ui.BootLiveActivityTab.Client]</MudTh><MudTh>@Loc[LocKeys.Ui.DriverFilesTab.File]</MudTh><MudTh>@Loc[LocKeys.Dashboard.Progress]</MudTh><MudTh>@Loc[LocKeys.Image.VersionStatus]</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Loc[LocKeys.Ui.BootLiveActivityTab.Client]">@context.Configuration.RemoteEndPoint</MudTd>
                <MudTd DataLabel="@Loc[LocKeys.Ui.DriverFilesTab.File]">@context.Configuration.Filename</MudTd>
                <MudTd DataLabel="@Loc[LocKeys.Dashboard.Progress]">
                    @context.Transferred.ToString("N0") / @context.Configuration.FileLength.ToString("N0") @Loc[LocKeys.Ui.BootLiveActivityTab.Bytes]
                    @if (context.State == CodePlex.JPMikkers.TFTP.SessionLogEntry.TState.Busy)
                    {
                        <MudProgressLinear Value="@(context.Configuration.FileLength > 0 ? Math.Clamp(100d * context.Transferred / context.Configuration.FileLength, 0, 100) : 0)" />
                    }
                </MudTd>
                <MudTd DataLabel="@Loc[LocKeys.Image.VersionStatus]">@UiText.Label(context.State)</MudTd>
            </RowTemplate>
        </MudTable>
    }
    <div @ref="_console" role="log" aria-label="@Loc[LocKeys.Ui.BootLiveActivityTab.BootServiceActivity]" style="height: 360px; overflow: auto; font-family: monospace; white-space: pre-wrap; overflow-wrap: anywhere; padding: 12px; background: var(--mud-palette-background-gray);">
        @if (_entries.Length == 0) { <span>@Loc[LocKeys.Ui.BootLiveActivityTab.NoRecentActivity]</span> }
        @foreach (var entry in _entries)
        {
            <div @key="entry.Id" style="@(entry.Level == "Error" ? "color: var(--mud-palette-error)" : entry.Level == "Warning" ? "color: var(--mud-palette-warning)" : null)">@entry.Time.ToString("HH:mm:ss") [@entry.Level] @entry.Message</div>
        }
    </div>
}
else if (_checked)
{
    <MudAlert Severity="Severity.Error">@Loc[LocKeys.Ui.BootLiveActivityTab.AdministratorAccessIsRequiredToViewBootActivity]</MudAlert>
}

@code {
    [Parameter, EditorRequired] public object ActionSectionId { get; set; } = null!;
    [Parameter] public bool Tftp { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    private bool _authorized, _checked, _paused, _disposed, _follow = true;
    private long _clearedThrough;
    private string _status = "";
    private BootActivityEntry[] _entries = [];
    private IReadOnlyList<CodePlex.JPMikkers.TFTP.SessionLogEntry> _transfers = [];
    private ElementReference _console;
    private IJSObjectReference? _module;
    private long _latestEntryId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _poll = PollAsync();
        if (_authorized && _follow && !_paused && !_disposed)
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bootActivity.js");
                await _module.InvokeVoidAsync("follow", _console);
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            do
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    var user = (await Authentication.GetAuthenticationStateAsync()).User;
                    _authorized = (await Authorization.AuthorizeAsync(user, Constants.Permissions.AdminOnly)).Succeeded;
                    _checked = true;
                    if (!_authorized) { _entries = []; _transfers = []; }
                    else if (!_paused)
                    {
                        var result = Tftp ? await TftpServer.GetActivityAsync() : await Pxe.GetActivityAsync();
                        if (result.Success)
                        {
                            var snapshot = result.Data!;
                            _latestEntryId = snapshot.Entries.LastOrDefault()?.Id ?? _latestEntryId;
                            _entries = snapshot.Entries.Where(x => x.Id > _clearedThrough).ToArray();
                            _status = snapshot.Status;
                            _transfers = snapshot.Transfers;
                        }
                        else
                        {
                            _entries = []; _transfers = [];
                            _status = Loc[result.Error!.Code, result.Error.Args];
                        }
                    }
                    StateHasChanged();
                });
            } while (await timer.WaitForNextTickAsync(_stop.Token));
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }
    private async Task Clear()
    {
        var result = Tftp ? await TftpServer.GetActivityAsync() : await Pxe.GetActivityAsync();
        if (_disposed) return;
        if (!result.Success)
        {
            _status = Loc[result.Error!.Code, result.Error.Args];
            return;
        }
        // Clearing while paused also discards activity received since the last displayed snapshot.
        _latestEntryId = result.Data!.Entries.LastOrDefault()?.Id ?? _latestEntryId;
        _clearedThrough = _latestEntryId;
        _entries = [];
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _stop.CancelAsync();
        if (_poll is not null) await _poll;
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        _stop.Dispose();
    }
}
