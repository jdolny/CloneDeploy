@inject ActionService Service

<PolicyActionEditScope Context="canEdit">
@if (_model is null)
{
    @if (_loadingAction) { <MudProgressLinear Indeterminate="true"/> }
    else { <MudAlert Severity="Severity.Error">@Loc[LocKeys.Ui.CommandActionConfigurationTab.UnableToLoadActionSettingsReopenThisTabTo]</MudAlert> }
}
else
{
    <div class="section-action-bar"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="OnSaveClicked" Disabled="@(!canEdit || (_saving))">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton></div>
    <MudForm @ref="_form" Disabled="@(!canEdit || (_saving))">
        <MudStack Spacing="6">
            <div>
                <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.Ui.NavMenu.FileDeployment]</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="12"><MudTextField @bind-Value="_model.Destination" Label="@Loc[LocKeys.Ui.FileActionConfigurationTab.DestinationPath]" Variant="Variant.Outlined" Required="true" /></MudItem>
                    <MudItem xs="12" md="6"><MudCheckBox @bind-Value="_model.DecompressAfterCopy" Label="@Loc[LocKeys.Ui.FileActionConfigurationTab.DecompressAfterCopying]" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" md="6"><MudCheckBox @bind-Value="_model.OverwriteExisting" Label="@Loc[LocKeys.Ui.FileActionConfigurationTab.OverwriteExistingFiles]" Color="Color.Primary" /></MudItem>
                </MudGrid>
            </div>

        </MudStack>
    </MudForm>

}

</PolicyActionEditScope>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private FileAction _model = null!;
    private bool _loadingAction = true;
    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetFileAsync(FileAction.Id);
        if (result.Success && result.HasData)
        {
            await LoadCatalogsAsync();
            _model = result.Data;
        }
        else if (!result.Success) Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _loadingAction = false;
    }

    private Task LoadCatalogsAsync() => Task.CompletedTask;
    [Parameter, EditorRequired] public FileAction FileAction { get; set; } = null!;
    private MudForm _form = null!;
    private bool _saving;

    private async Task OnSaveClicked()
    {
        if (_saving) return;
        _saving = true;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            _saving = false;
            return;
        }
        var result = await Service.UpdateFileAsync(_model);
        _saving = false;
        if (result.Success) await OnSaved.InvokeAsync();
        Snackbar.Add(result.Success ? Loc[LocKeys.Action.ConfigurationSaved] : Loc[result.Error!.Code, result.Error.Args], result.Success ? Severity.Success : Severity.Error);
    }
}
