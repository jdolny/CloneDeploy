<MudDataGrid T="Policy" Items="_items" QuickFilter="@(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))"
             Dense="true" Hover="true" Loading="_loading" Elevation="0" Outlined="true" Class="device-list-grid" RowsPerPage="@Constants.UI.DefaultPageSize">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Color="Color.Primary"/>
        <MudStack Spacing="0"><MudText Typo="Typo.h6">@Loc[LocKeys.Action.UsedBy]</MudText></MudStack>
        <MudSpacer/>
        <MudTextField T="string" @bind-Value="_search" DebounceInterval="300" Clearable="true" Placeholder="@Loc[LocKeys.Ui.ActionFiles.Search]" aria-label="@Loc[LocKeys.Ui.ActionUsedByTab.SearchUsedBy]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="device-inventory-search"/>
    </ToolBarContent>
    <Columns><PropertyColumn Property="x => x.Id" Title="@Loc[LocKeys.Ui.ActionUsedByTab.PolicyID]"/><PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Ui.ActionUsedByTab.PolicyName]"><CellTemplate><MudLink Href="@($"/policies/{context.Item.Id}")">@context.Item.Name</MudLink></CellTemplate></PropertyColumn></Columns>
    <NoRecordsContent><MudText>@Loc[LocKeys.Action.NoPolicies]</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="Policy"/></PagerContent>
</MudDataGrid>

@code {
    [Parameter] public Guid ActionGuid { get; set; }
    [Parameter, EditorRequired] public Func<Guid, Task<ServiceResult<List<Policy>>>> Load { get; set; } = null!;
    private List<Policy> _items = [];
    private bool _loading = true;
    private Guid? _loadedGuid;
    private string? _search;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedGuid == ActionGuid) return;
        _loadedGuid = ActionGuid;
        _loading = true;
        var result = await Load(ActionGuid);
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        else if (result.HasData)
            _items = result.Data;
        _loading = false;
    }
}
