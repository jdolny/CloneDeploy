@inject ActionService Actions

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
<MudDataGrid T="ActionExecutionHistoryDto" Items="_rows" QuickFilter="Matches" Loading="_loading"
             Dense="true" Hover="true" Elevation="0" Outlined="true" Class="device-list-grid"
             RowsPerPage="@Constants.UI.DefaultPageSize" HorizontalScrollbar="true">
    <ToolBarContent>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">@Loc[LocKeys.Ui.ActionExecutionHistoryTab.Deployments]</MudText>
            <MudText Typo="Typo.caption">@Loc[LocKeys.Ui.ActionExecutionHistoryTab.Latest200DirectDeploymentResultsPolicyRunsAreRecorded]</MudText>
        </MudStack>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="_search" DebounceInterval="300" Clearable="true" Placeholder="@Loc[LocKeys.Ui.ActionFiles.Search]"
                      aria-label="@Loc[LocKeys.Ui.DeploymentsPage.SearchDeployments_03fa9171]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="device-inventory-search" />
    </ToolBarContent>
    <Columns>
        <TemplateColumn Title="@Loc[LocKeys.Ui.WinPeBuilderSetup.Requested]"><CellTemplate>@context.Item.CreatedAtUtc.ToLocalTime().ToString("g")</CellTemplate></TemplateColumn>
        <PropertyColumn Property="x => x.DeviceName" Title="@Loc[LocKeys.Dashboard.Device]" />
        <PropertyColumn Property="x => x.RequestedBy" Title="@Loc[LocKeys.Dashboard.RequestedBy]" />
        <PropertyColumn Property="x => x.Status" Title="@Loc[LocKeys.Image.VersionStatus]" />
        <TemplateColumn Title="@Loc[LocKeys.Dashboard.FinishedAt]"><CellTemplate>@context.Item.FinishedAtUtc?.ToLocalTime().ToString("g")</CellTemplate></TemplateColumn>
        <PropertyColumn Property="x => x.Result" Title="@Loc[LocKeys.Dashboard.Result]" />
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">@(_error is not null ? UiText.Get(LocKeys.Ui.ActionExecutionHistoryTab.DeploymentHistoryIsUnavailable) : UiText.Get(LocKeys.Ui.ActionExecutionHistoryTab.NoDirectDeploymentsRecorded))</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="ActionExecutionHistoryDto" /></PagerContent>
</MudDataGrid>
@code {
    [Parameter] public Guid ActionGuid { get; set; }
    private List<ActionExecutionHistoryDto> _rows = [];
    private Guid? _loaded;
    private string? _search, _error;
    private bool _loading = true;
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == ActionGuid) return;
        _loaded = ActionGuid;
        _loading = true; _rows = []; _error = null;
        var guid = ActionGuid;
        var result = await Actions.GetExecutionHistoryAsync(guid);
        if (guid != ActionGuid) return;
        if (result.Success) _rows = result.Data!;
        else _error = Loc[result.Error!.Code, result.Error.Args];
        _loading = false;
    }
    private bool Matches(ActionExecutionHistoryDto row) => string.IsNullOrWhiteSpace(_search) ||
        $"{row.DeviceName} {row.RequestedBy} {row.Status} {row.Result}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);
}
