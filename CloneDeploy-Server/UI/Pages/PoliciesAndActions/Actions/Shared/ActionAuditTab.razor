<MudDataGrid T="AuditLog" Items="_items" QuickFilter="@(x => string.IsNullOrWhiteSpace(_search) || (x.UserName + " " + x.AuditType).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))"
             Dense="true" Hover="true" Loading="_loading" Elevation="0" Outlined="true" Class="device-list-grid" RowsPerPage="@Constants.UI.DefaultPageSize">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Outlined.History" Color="Color.Primary"/>
        <MudStack Spacing="0"><MudText Typo="Typo.h6">@Loc[LocKeys.Action.AuditHistory]</MudText><MudText Typo="Typo.caption">@Loc[LocKeys.Action.LatestEvents]</MudText></MudStack>
        <MudSpacer/>
        <MudTextField T="string" @bind-Value="_search" DebounceInterval="300" Clearable="true" Placeholder="@Loc[LocKeys.Ui.ActionFiles.Search]" aria-label="@Loc[LocKeys.Ui.ActionAuditTab.SearchAuditHistory]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="device-inventory-search"/>
    </ToolBarContent>
    <Columns><TemplateColumn Title="@Loc[LocKeys.Device.Date]"><CellTemplate>@context.Item.LoggedAtUtc.ToLocalTime().ToString("g")</CellTemplate></TemplateColumn><PropertyColumn Property="x => x.UserName" Title="@Loc[LocKeys.User.UserMembership]"/><PropertyColumn Property="x => x.AuditType" Title="@Loc[LocKeys.Image.AuditType]"/></Columns>
    <NoRecordsContent><MudText>@Loc[LocKeys.Action.NoAuditEvents]</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="AuditLog"/></PagerContent>
</MudDataGrid>

@code {
    [Parameter] public Guid ActionGuid { get; set; }
    [Parameter, EditorRequired] public Func<Guid, Task<ServiceResult<List<AuditLog>>>> Load { get; set; } = null!;
    private List<AuditLog> _items = [];
    private bool _loading = true;
    private Guid? _loadedGuid;
    private string? _search;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedGuid == ActionGuid) return;
        _loadedGuid = ActionGuid;
        _loading = true;
        var result = await Load(ActionGuid);
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        else if (result.HasData)
            _items = result.Data;
        _loading = false;
    }
}
