
@inject ActionService Service

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Loc[LocKeys.Ui.SoftwareActionDialog.NewSoftwareAction]</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Disabled="_saving">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="SoftwareAction.Name" Label="@Loc[LocKeys.Common.Name]" Required="true" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="SoftwareAction.Description" Label="@Loc[LocKeys.Common.Description]" Lines="4" Variant="Variant.Outlined" />

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClicked" Disabled="_saving">@Loc[LocKeys.Common.Cancel]</MudButton>
        <MudButton OnClick="OnSaveClicked" Disabled="_saving" Color="Color.Primary" Variant="Variant.Filled">@(_saving ? UiText.Get(LocKeys.Ui.CommandActionDialog.Creating) : UiText.Get(LocKeys.Common.Create))</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private void OnCancelClicked() => MudDialog.Cancel();
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;
    [Parameter] public SoftwareAction SoftwareAction { get; set; } = new();
    private bool _saving;
    private async Task OnSaveClicked()
    {
        if (_saving) return;
        _saving = true;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            _saving = false;
            return;
        }
        var result = await Service.CreateSoftwareAsync(SoftwareAction);
        _saving = false;
        if (result.Success) MudDialog.Close(DialogResult.Ok(result.Data!.Id));
        else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
    }
}
