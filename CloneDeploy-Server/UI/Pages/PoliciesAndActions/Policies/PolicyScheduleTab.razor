@using CloneDeploy_Agent.Contracts
@inject PolicyService PolicyService

@if (_loading)
{
    <MudProgressLinear Indeterminate="true"/>
}
else if (_details is not null)
{
    <div>
        <div class="section-action-bar">
            <MudButton OnClick="@Snackbar.GuardAction(() => ReadOnly || _saving, UiText.Get(LocKeys.Ui.PolicyExecutionTab.ThisPolicyIsArchivedOrYouDoNotHave), OnSaveClicked)" Disabled="@(_saving)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton>
        </div>
        <MudText Typo="Typo.h6" Class="mb-3">@Loc[LocKeys.Policy.Schedule]</MudText>
        <MudForm @ref="_form" Disabled="@(ReadOnly || _saving)">
            <PolicyTriggers Details="_details"/>
        </MudForm>
    </div>
}

@code {
    [Parameter] public int PolicyId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<PolicyFrequency> FrequencySaved { get; set; }

    private int? _loadedPolicyId;
    private PolicyDetailsDto? _details;
    private MudForm _form = null!;
    private bool _loading = true, _saving;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedPolicyId == PolicyId) return;
        _loadedPolicyId = PolicyId;
        _loading = true;
        var result = await PolicyService.GetSectionAsync(PolicyId, "schedule");
        if (!result.Success)
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        else if (result.HasData)
            _details = result.Data;
        _loading = false;
    }

    private async Task OnSaveClicked()
    {
        if (_saving || ReadOnly) return;
        _saving = true;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            _saving = false;
            return;
        }
        var result = await PolicyService.SaveAsync(_details!, "schedule");
        if (result.Success)
        {
            await FrequencySaved.InvokeAsync(_details!.Policy.Frequency);
            Snackbar.Add(Loc[LocKeys.Policy.SettingsSaved], Severity.Success);
        }
        else
            Snackbar.Add(Loc[result.Error.Code, result.Error.Args], Severity.Error);
        _saving = false;
    }
}
