@page "/account/password"
@attribute [Authorize]
@inject AppUserService Passwords

<AppPageTitle Text="@Title" />

<MudPaper Class="pa-4" Elevation="0">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_saved)
    {
        <MudAlert Severity="Severity.Success">@Loc[LocKeys.Ui.ChangePasswordPage.PasswordUpdatedPleaseSignInAgain]</MudAlert>
        <form method="post" action="/auth/logout" class="mt-4">
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Ui.ChangePasswordPage.SignInAgain]</MudButton>
        </form>
    }
    else if (_options is null)
    {
        <MudAlert Severity="Severity.Info">@Loc[LocKeys.Ui.ChangePasswordPage.PasswordChangesAreUnavailableForThisAccountActiveDirectory]</MudAlert>
    }
    else
    {
        <MudText Class="mb-4">@(_options.IsEntra ? UiText.Get(LocKeys.Ui.ChangePasswordPage.ThisPasswordIsUsedForImagerOnlyContinueUsing) : UiText.Get(LocKeys.Ui.ChangePasswordPage.ThisPasswordIsUsedForBothWebAndImager))</MudText>
        <MudForm @ref="_form">
            <div class="d-flex justify-end mb-4">
                <MudButton OnClick="SaveAsync" Disabled="_saving" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Ui.ActionFiles.SaveChanges]</MudButton>
            </div>

            <MudGrid>
                <MudItem xs="12" md="6">
                    @if (_options.HasPassword)
                    {
                        <MudTextField @bind-Value="_current" Label="@Loc[LocKeys.Ui.ChangePasswordPage.CurrentPassword]" InputType="InputType.Password" Variant="Variant.Outlined" Required="true" autocomplete="current-password" />
                    }
                    <MudTextField @bind-Value="_new" Label="@Loc[LocKeys.Ui.ChangePasswordPage.NewPassword]" InputType="InputType.Password" Variant="Variant.Outlined" Required="true" autocomplete="new-password" />
                    <MudTextField @bind-Value="_confirmation" Label="@Loc[LocKeys.Ui.ChangePasswordPage.ConfirmNewPassword]" InputType="InputType.Password" Variant="Variant.Outlined" Required="true" autocomplete="new-password" />
                </MudItem>
            </MudGrid>
        </MudForm>
    }
</MudPaper>

@code {
    private AccountPasswordOptions? _options;
    private MudForm _form = null!;
    private bool _loading = true, _saving, _saved;
    private string _current = "", _new = "", _confirmation = "";
    private string Title => _options?.IsEntra == true ? UiText.Get(LocKeys.Ui.AccountMenu.ChangeImagerPassword) : UiText.Get(LocKeys.Ui.AccountMenu.ChangePassword);

    protected override async Task OnInitializedAsync()
    {
        var result = await Passwords.GetPasswordAsync();
        if (result.Success) _options = result.Data;
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            var result = await Passwords.ChangePasswordAsync(_current, _new, _confirmation);
            if (result.Success)
            {
                _current = _new = _confirmation = "";
                _saved = true;
            }
            else Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error);
        }
        finally { _saving = false; }
    }
}
