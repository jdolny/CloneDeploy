@inject InstallationWelcome Welcome
@inject ILogger<InstallationWelcomePanel> Logger

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_show)
{
    <MudPaper Outlined="true" Class="pa-6 mx-auto" Style="max-width: 900px;">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h3" HtmlTag="h1">@Loc[LocKeys.Ui.InstallationWelcomePanel.WelcomeToCloneDeploy]</MudText>
            <OpenSourceInformation />
            <MudText Typo="Typo.body2">@Loc[LocKeys.Ui.InstallationWelcomePanel.YouReReadyToGetStartedLicensesAndNotices]</MudText>
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueAsync" Disabled="_busy">@Loc[LocKeys.Ui.InstallationWelcomePanel.Continue]</MudButton>
                <form method="post" action="/auth/logout">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text">@Loc[LocKeys.Ui.InstallationWelcomePanel.SignOut]</MudButton>
                </form>
            </MudStack>
        </MudStack>
    </MudPaper>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _loading = true;
    private bool _show;
    private bool _busy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _show = await Welcome.TryShowAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load the installation introduction"); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task ContinueAsync()
    {
        _busy = true;
        try { await Welcome.ContinueAsync(); _show = false; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not record continuation from installation introduction");
            Snackbar.Add(UiText.Get(LocKeys.Ui.InstallationWelcomePanel.CouldnTSaveRightNowPleaseTryContinueAgain), Severity.Warning);
        }
        finally { _busy = false; }
    }
}
