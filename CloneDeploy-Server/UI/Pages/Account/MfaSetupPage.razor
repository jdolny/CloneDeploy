@page "/account/mfa"
@attribute [AllowMfaEnrollment]
@layout AuthLayout
@using QRCoder
@inject AccountMfaSetup Setup
@inject ILogger<MfaSetupPage> Logger

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-4">@Loc[LocKeys.Ui.MfaSetupPage.AuthenticatorApp]</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Warning" Class="mb-3">@_error</MudAlert> }
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_verified)
    {
        <MudText Class="mb-3">@Loc[LocKeys.Ui.MfaSetupPage.YourAuthenticatorIsVerifiedSignInAgainToContinue]</MudText>
        <form method="post" action="/auth/logout"><MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">@Loc[LocKeys.Ui.MfaSetupPage.SignInAgain]</MudButton></form>
    }
    else if (!_failed)
    {
        @if (Setup.PendingKey is null && Setup.Enabled)
        {
            <MudText Class="mb-3">@Loc[LocKeys.Ui.MfaSetupPage.YourAuthenticatorIsEnabledOpeningThisPageDoesNot]</MudText>
            <MudText Class="mb-3">@Loc[LocKeys.Ui.MfaSetupPage.ToReplaceItEnterACurrentAuthenticatorCodeYour]</MudText>
            <MudTextField @bind-Value="_currentCode" Label="@Loc[LocKeys.Ui.MfaSetupPage.CurrentAuthenticatorCode]" Variant="Variant.Outlined" Class="mb-3" Disabled="_busy" />
            <MudButton OnClick="ReplaceAsync" Disabled="_busy" Variant="Variant.Outlined">@Loc[LocKeys.Ui.MfaSetupPage.SetUpAReplacement]</MudButton>
            <MudButton Href="/" Class="ml-2">@Loc[LocKeys.Ui.MfaSetupPage.BackToCloneDeploy]</MudButton>
        }
        else
        {
            <MudText Class="mb-3">@Loc[LocKeys.Ui.MfaSetupPage.AdministratorSignInsRequireMFA]</MudText>
            @if (_qrCode is not null)
            {
                <img src="@_qrCode" alt="@Loc[LocKeys.Ui.MfaSetupPage.AuthenticatorSetupQRCode]" width="256" height="256" style="display: block; margin-inline: auto; max-width: 100%; height: auto; image-rendering: pixelated;" />
            }
            <MudTextField Value="@Setup.PendingKey" Label="@Loc[LocKeys.Ui.MfaSetupPage.ManualSetupKey]" ReadOnly="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_verificationCode" Label="@Loc[LocKeys.Ui.MfaSetupPage.CodeFromAuthenticator]" Variant="Variant.Outlined" Class="mb-3" Disabled="_busy" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="VerifyAsync" Disabled="_busy">@Loc[LocKeys.Ui.MfaSetupPage.VerifyAuthenticator]</MudButton>
        }
    }
    @if (!_verified)
    {
        <form method="post" action="/auth/logout" class="mt-3"><MudButton ButtonType="ButtonType.Submit">@Loc[LocKeys.Ui.InstallationWelcomePanel.SignOut]</MudButton></form>
    }
</MudPaper>

@code {
    private string? _qrCode;
    private string _verificationCode = "";
    private string _currentCode = "";
    private bool _verified, _busy, _failed;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Pending keys belong to the interactive circuit. Prerendering uses a separate
        // service scope and would briefly show a different, unusable enrollment key.
        if (!RendererInfo.IsInteractive) return;

        try { await Setup.LoadAsync(); UpdateQrCode(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not read authenticator setup"); _failed = true; _error = UiText.Get(LocKeys.Ui.MfaSetupPage.SignOutAndSignInAgainToManageYour); }
        finally { _loading = false; }
    }

    private async Task ReplaceAsync()
    {
        _busy = true; _error = null;
        try
        {
            if (await Setup.BeginReplacementAsync(_currentCode)) { _currentCode = ""; UpdateQrCode(); }
            else _error = UiText.Get(LocKeys.Ui.MfaSetupPage.TheCodeWasNotAcceptedCheckTheCodeAnd);
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not prepare authenticator replacement"); _error = UiText.Get(LocKeys.Ui.MfaSetupPage.SignOutAndSignInAgainToManageYour); }
        finally { _busy = false; }
    }

    private async Task VerifyAsync()
    {
        _busy = true; _error = null;
        try
        {
            _verified = await Setup.VerifyAsync(_verificationCode);
            if (!_verified) _error = UiText.Get(LocKeys.Ui.MfaSetupPage.TheCodeWasNotAcceptedOrSetupExpiredCheck);
            else { _qrCode = null; _verificationCode = ""; }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not verify authenticator setup"); _error = UiText.Get(LocKeys.Ui.MfaSetupPage.CouldNotSaveAuthenticatorSetupSignOutAndSign); }
        finally { _busy = false; }
    }

    private void UpdateQrCode()
    {
        _qrCode = null;
        if (Setup.PendingKey is null) return;
        var uri = $"otpauth://totp/CloneDeploy:{Uri.EscapeDataString(Setup.AccountName ?? "Account")}?secret={Uri.EscapeDataString(Setup.PendingKey)}&issuer=CloneDeploy&algorithm=SHA1&digits=6&period=30";
        using var data = QRCodeGenerator.GenerateQrCode(uri, QRCodeGenerator.ECCLevel.Q);
        using var qr = new PngByteQRCode(data);
        _qrCode = "data:image/png;base64," + Convert.ToBase64String(qr.GetGraphic(8));
    }
}
