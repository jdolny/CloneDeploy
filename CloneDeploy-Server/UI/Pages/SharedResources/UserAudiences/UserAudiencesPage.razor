@page "/shared/user-audiences"
@attribute [Authorize(Policy = Constants.Permissions.UserAudienceView)]
@inject PolicyService Audiences
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider Authentication

<AppPageTitle Text="@Loc[LocKeys.Ui.NavMenu.UserAudiences]" />
@if (_canEdit)
{
    <ActionButtons><MainButton><MudButton OnClick="CreateAsync" StartIcon="@Icons.Material.Filled.Add">@Loc[LocKeys.Ui.UserAudiencesPage.NewAudience]</MudButton></MainButton></ActionButtons>
}
<ResourceListSearch SearchClass="shared-resource-search" Label="@Loc[LocKeys.Ui.UserAudiencesPage.SearchAudiences]" ValueChanged="@(value => _search = value)" Loading="_loading" />
@if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
<MudDataGrid T="UserAudience" Items="_items.Where(x => x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))"
             Loading="_loading" Dense="true" Hover="true" Class="device-list-grid" RowsPerPage="@Constants.UI.DefaultPageSize">
    <ToolBarContent><MudText Typo="Typo.h6">@Loc[LocKeys.Ui.UserAudiencesPage.UserAudiences]</MudText></ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@Loc[LocKeys.Common.Name]"><CellTemplate><MudLink Class="resource-name-link" Href="@($"/shared/user-audiences/{context.Item.Id}")">@context.Item.Name</MudLink></CellTemplate></PropertyColumn>
        <PropertyColumn Property="x => x.Description" Title="@Loc[LocKeys.Common.Description]" />
        @if (_canEdit)
        {
            <TemplateColumn Title="@Loc[LocKeys.Common.Actions]" StickyRight="true" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudTooltip Text="@(UiText.Get(LocKeys.Ui.ActionFiles.Delete0, context.Item.Name))" Placement="Placement.Left">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Disabled="@(_busy || _loading)"
                                       aria-label="@(UiText.Get(LocKeys.Ui.ActionFiles.Delete0_7eab122c, context.Item.Name))" OnClick="@(() => DeleteAsync(context.Item))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <NoRecordsContent><MudText Class="pa-3">@Loc[LocKeys.Ui.UserAudiencesPage.NoUserAudiencesFound]</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="UserAudience" /></PagerContent>
</MudDataGrid>

@code {
    private List<UserAudience> _items = [];
    private string _search = "";
    private string? _error;
    private bool _loading, _canEdit, _busy;
    private async Task DeleteAsync(UserAudience audience)
    {
        if (!_canEdit || _busy || _loading) return;
        _busy = true;
        try
        {
            if (await Dialog.ShowMessageBoxAsync(UiText.Get(LocKeys.Ui.ManageUserAudiencePage.DeleteAudience_475365b8),
                UiText.Get(LocKeys.Ui.ManageUserAudiencePage.AudiencesAssignedToPoliciesCannotBeDeletedDeleteThis),
                yesText: UiText.Get(LocKeys.Common.Delete), cancelText: UiText.Get(LocKeys.Common.Cancel)) != true) return;
            var result = await Audiences.SaveUserAudienceAsync(audience, delete: true);
            if (!result.Success) { Snackbar.Add(Loc[result.Error!.Code, result.Error.Args], Severity.Error); return; }
            Snackbar.Add(Loc[LocKeys.Common.Deleted, audience.Name], Severity.Success);
            await Load();
        }
        catch { Snackbar.Add(UiText.Get(LocKeys.Ui.ManageUserAudiencePage.CouldNotDeleteTheAudience), Severity.Error); }
        finally { _busy = false; }
    }
    private async Task CreateAsync()
    {
        if (!_canEdit) return;
        var dialog = await Dialog.ShowAsync<UserAudienceCreateDialog>(Loc[LocKeys.Ui.UserAudiencesPage.NewAudience],
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false, Data: int id })
            Navigation.NavigateTo($"/shared/user-audiences/{id}");
    }
    protected override async Task OnInitializedAsync()
    {
        _canEdit = (await Authorization.AuthorizeAsync((await Authentication.GetAuthenticationStateAsync()).User, Constants.Permissions.UserAudienceEdit)).Succeeded;
        await Load();
    }
    private async Task Load()
    {
        _loading = true;
        try
        {
            var result = await Audiences.ListUserAudienceAsync();
            if (result.Success) { _items = result.Data!; _error = null; }
            else _error = Loc[result.Error!.Code, result.Error.Args];
        }
        catch { _error = UiText.Get(LocKeys.Ui.UserAudiencesPage.CouldNotLoadUserAudiences); }
        finally { _loading = false; }
    }
}
